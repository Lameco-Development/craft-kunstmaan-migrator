<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         testdox="true"
         cacheDirectory=".phpunit.cache"
         requireCoverageMetadata="false"
         failOnPhpunitWarning="false">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/integration</directory>
        </testsuite>
        <!-- The compile engine: reads the legacy database and the mapping, and knows nothing
             about Craft. Kept as its own suite because it needs no Craft bootstrap and runs in
             a fraction of a second, which is worth protecting. -->
        <testsuite name="Compile">
            <directory>lib/kuma-compile/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <!-- src/fields and src/safety were listed here until now; both were deleted
                 by the v2 prune, and a coverage report that names directories which do not
                 exist is how the gate came to be guarding one file while reading as five. -->
            <directory>src/adapters</directory>
            <directory>src/craft</directory>
            <directory>src/db</directory>
            <directory>src/finalize</directory>
            <directory>src/load</directory>
            <directory>src/payload</directory>
            <directory>src/queue</directory>
            <directory>src/run</directory>
            <directory>src/sites</directory>
            <directory>lib/kuma-compile/src</directory>
        </include>
    </source>
    <coverage>
        <report>
            <clover outputFile="build/coverage/clover.xml"/>
        </report>
    </coverage>
</phpunit>
