#!/usr/bin/env php
<?php

declare(strict_types=1);

use Lameco\Kunstmaanmigrator\Command\BootstrapCommand;
use Lameco\Kunstmaanmigrator\Command\CompileCommand;
use Lameco\Kunstmaanmigrator\Command\CoverageCommand;
use Lameco\Kunstmaanmigrator\Command\InitCommand;
use Lameco\Kunstmaanmigrator\Command\IntrospectCommand;
use Lameco\Kunstmaanmigrator\Command\SuggestCommand;
use Lameco\Kunstmaanmigrator\Command\SurveyCommand;
use Lameco\Kunstmaanmigrator\Command\DoctorCommand;
use Lameco\Kunstmaanmigrator\Command\ReadinessCommand;
use Lameco\Kunstmaanmigrator\Command\ValidateCommand;
use Symfony\Component\Console\Application;

// Candidates, in order: this repo's own vendor, and the host project's vendor when the
// plugin is installed as a Composer dependency (vendor/bin/kuma-compile proxies here).
$autoloads = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$loaded = false;

foreach ($autoloads as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        $loaded = true;

        break;
    }
}

if (!$loaded) {
    fwrite(STDERR, "kuma-compile: could not find a Composer autoloader.\n");

    exit(1);
}

$app = new Application('kuma-compile', '0.1.0');
$app->add(new BootstrapCommand());
$app->add(new SurveyCommand());
$app->add(new IntrospectCommand());
$app->add(new InitCommand());
$app->add(new ValidateCommand());
$app->add(new SuggestCommand());
$app->add(new DoctorCommand());
$app->add(new CoverageCommand());
$app->add(new ReadinessCommand());
$app->add(new CompileCommand());
$app->run();
