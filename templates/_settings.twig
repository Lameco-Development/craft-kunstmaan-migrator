{# Phase 12 / Plan 05 — concise CP Settings boundary.
   Groups stay site-safe and stable: Connectivity, Mapping, Execution,
   Adapters, Retention. Advanced project-shape hints remain in
   config/kunstmaan-migrator.php rather than CP Settings.

   Rendering contract: hasCpSettings = true + Plugin::settingsHtml() renders
   this template through the registered kunstmaan-migrator CP template root.
   Craft's settings/plugins/_settings.twig (cms vendor)
   already inherits the CP layout, opens fullPageForm, injects
   actionInput/pluginHandle/redirectInput, then dumps `settingsHtml|raw`
   inside its own content block. This template is therefore an HTML
   FRAGMENT — no layout-inheritance directive, no content-block wrapper,
   no <form> or csrf/action inputs (would nest layouts and double-form).
#}
{% import "_includes/forms" as forms %}

{% set settingsSections = [
    { id: 'connectivity', label: 'Connectivity'|t('kunstmaan-migrator') },
    { id: 'mapping', label: 'Mapping'|t('kunstmaan-migrator') },
    { id: 'execution', label: 'Execution'|t('kunstmaan-migrator') },
    { id: 'adapters', label: 'Adapters'|t('kunstmaan-migrator') },
    { id: 'retention', label: 'Retention'|t('kunstmaan-migrator') },
] %}

<style>
    .km-settings-layout {
        display: grid;
        grid-template-columns: minmax(160px, 220px) minmax(0, 1fr);
        gap: 24px;
        align-items: start;
    }

    .km-settings-sidebar {
        position: sticky;
        top: 24px;
    }

    .km-settings-sidebar ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .km-settings-sidebar a {
        display: block;
        padding: 7px 10px;
        border-radius: 4px;
        color: inherit;
        text-decoration: none;
    }

    .km-settings-sidebar a:hover,
    .km-settings-sidebar a:focus {
        background: #f3f7fc;
    }

    .km-settings-section {
        scroll-margin-top: 24px;
    }

    .km-settings-section + .km-settings-section {
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid #e3e5e8;
    }

    @media (max-width: 799px) {
        .km-settings-layout {
            display: block;
        }

        .km-settings-sidebar {
            position: static;
            margin-bottom: 24px;
        }
    }
</style>

<div class="km-settings-layout">
    <nav class="km-settings-sidebar" aria-label="{{ 'Kunstmaan Migrator settings sections'|t('kunstmaan-migrator') }}">
        <ul>
            {% for section in settingsSections %}
                <li><a href="#km-settings-{{ section.id }}">{{ section.label }}</a></li>
            {% endfor %}
        </ul>
    </nav>

    <div class="km-settings-content">
        <section id="km-settings-connectivity" class="km-settings-section">
            <h2>{{ 'Connectivity'|t('kunstmaan-migrator') }}</h2>

{{ forms.autosuggestField({
    label: 'Legacy DB host'|t('kunstmaan-migrator'),
    id: 'legacyDbServer',
    name: 'legacyDbServer',
    value: settings.legacyDbServer,
    suggestEnvVars: true,
    instructions: 'Defaults to `CRAFT_LEGACY_DB_SERVER` env var, or autofills from `KUNSTMAAN_SOURCE_PATH/.env` `DATABASE_URL` when blank (Phase 4.1 / CFG-04).'|t('kunstmaan-migrator'),
}) }}

{{ forms.textField({
    label: 'Legacy DB port'|t('kunstmaan-migrator'),
    id: 'legacyDbPort',
    name: 'legacyDbPort',
    type: 'number',
    value: settings.legacyDbPort,
    instructions: 'Defaults to `CRAFT_LEGACY_DB_PORT` env var (or 3306). Autofills from `DATABASE_URL` when at default.'|t('kunstmaan-migrator'),
}) }}

{{ forms.autosuggestField({
    label: 'Legacy DB database'|t('kunstmaan-migrator'),
    id: 'legacyDbDatabase',
    name: 'legacyDbDatabase',
    value: settings.legacyDbDatabase,
    suggestEnvVars: true,
    instructions: 'Defaults to `CRAFT_LEGACY_DB_DATABASE` env var. Autofills from `DATABASE_URL` when blank.'|t('kunstmaan-migrator'),
}) }}

{{ forms.autosuggestField({
    label: 'Legacy DB user'|t('kunstmaan-migrator'),
    id: 'legacyDbUser',
    name: 'legacyDbUser',
    value: settings.legacyDbUser,
    suggestEnvVars: true,
    instructions: 'Defaults to `CRAFT_LEGACY_DB_USER` env var. Autofills from `DATABASE_URL` when blank.'|t('kunstmaan-migrator'),
}) }}

{# G-03 fix preserved (D-19) — passwordField macro masks display. #}
{{ forms.passwordField({
    label: 'Legacy DB password'|t('kunstmaan-migrator'),
    id: 'legacyDbPassword',
    name: 'legacyDbPassword',
    value: settings.legacyDbPassword,
    instructions: 'Type `$CRAFT_LEGACY_DB_PASSWORD` (env reference) or paste a raw value. Resolved via `App::parseEnv()` at read time. Autofills from `DATABASE_URL` when blank. Never logged.'|t('kunstmaan-migrator'),
}) }}

{# G-03 fix preserved (D-19) — passwordField macro masks display. #}
{{ forms.textField({
    label: 'Anthropic API key'|t('kunstmaan-migrator'),
    id: 'anthropicApiKey',
    name: 'anthropicApiKeyMasked',
    value: settings.anthropicApiKey ? '•••••••• configured' : 'Not configured',
    readonly: true,
    instructions: 'Read-only presence display. Configure the key through `ANTHROPIC_API_KEY` or config/kunstmaan-migrator.php; raw keys are never rendered in the Control Panel.'|t('kunstmaan-migrator'),
}) }}

        </section>

        <section id="km-settings-mapping" class="km-settings-section">
            <h2>{{ 'Mapping'|t('kunstmaan-migrator') }}</h2>

{{ forms.autosuggestField({
    label: 'Kunstmaan source path'|t('kunstmaan-migrator'),
    id: 'kunstmaanSourcePath',
    name: 'kunstmaanSourcePath',
    value: settings.kunstmaanSourcePath,
    suggestEnvVars: true,
    instructions: 'Filesystem path to the Kunstmaan source checkout (must contain `src/Entity/`). Required for `analyze` and CFG-04 .env auto-fill. Defaults to `KUNSTMAAN_SOURCE_PATH` env var.'|t('kunstmaan-migrator'),
}) }}

{{ forms.autosuggestField({
    label: 'Mapping file path'|t('kunstmaan-migrator'),
    id: 'mappingPath',
    name: 'mappingPath',
    value: settings.mappingPath,
    suggestEnvVars: true,
    instructions: 'Path to the canonical `mapping.yaml`. Leave empty for the plugin default (`storage/migration/mapping.yaml`).'|t('kunstmaan-migrator'),
}) }}

{# CFG-06 — D-21 + D-22: dropdowns where source data is knowable. Legacy
   column falls back to free-text when localeOptions is empty (DB unreachable). #}
{{ forms.editableTableField({
    label: 'Locale map'|t('kunstmaan-migrator'),
    instructions: 'Explicit override map: legacy Kunstmaan locale → Craft site handle. Wins over exact-match and language-prefix loose-match.'|t('kunstmaan-migrator'),
    id: 'localeMap',
    name: 'localeMap',
    cols: {
        legacy: {
            heading: 'Legacy locale'|t('kunstmaan-migrator'),
            type: localeOptions ? 'select' : 'singleline',
            options: localeOptions ?? [],
        },
        craft: {
            heading: 'Craft site handle'|t('kunstmaan-migrator'),
            type: 'select',
            options: siteHandleOptions,
        },
    },
    rows: settings.localeMap|default([]),
    addRowLabel: 'Add locale mapping'|t('kunstmaan-migrator'),
    allowAdd: true,
    allowDelete: true,
}) }}

{{ forms.editableTableField({
    label: 'Default filters'|t('kunstmaan-migrator'),
    instructions: 'Optional site-safe defaults for CP queued actions, such as entities, locales, or since. CLI flags still override per run.'|t('kunstmaan-migrator'),
    id: 'defaultFilters',
    name: 'defaultFilters',
    cols: {
        key: {
            heading: 'Filter'|t('kunstmaan-migrator'),
            type: 'singleline',
        },
        value: {
            heading: 'Value'|t('kunstmaan-migrator'),
            type: 'singleline',
        },
    },
    rows: settings.defaultFilters|default([]),
    addRowLabel: 'Add default filter'|t('kunstmaan-migrator'),
    allowAdd: true,
    allowDelete: true,
}) }}

{# Phase 8.5 / D-24 — optional Doctrine ManyToOne FK relation expansion.
   Defaults OFF so extracted JSON stays source-faithful: raw FK columns such
   as employee_id are present, while synthetic `_rel:<prop>.<col>` helper keys
   are opt-in for operator/debug workflows. CLI --no-rel-join still bypasses
   per-run if this setting is enabled. #}
{{ forms.lightswitchField({
    label: 'Expand Doctrine ManyToOne FK relations in extracted JSON'|t('kunstmaan-migrator'),
    id: 'joinFkRelations',
    name: 'joinFkRelations',
    on: settings.joinFkRelations,
    instructions: 'When OFF, extracted JSON keeps only factual source values such as `employee_id`. When ON, page and page-part rows also carry related entity columns under `_rel:<property>.<column>` keys for debugging or hand-curated mappings. CLI --no-rel-join bypasses per-run.'|t('kunstmaan-migrator'),
}) }}

        </section>

        <section id="km-settings-execution" class="km-settings-section">
            <h2>{{ 'Execution'|t('kunstmaan-migrator') }}</h2>

{{ forms.lightswitchField({
    label: 'Allow CP queue actions'|t('kunstmaan-migrator'),
    id: 'allowCpQueueActions',
    name: 'allowCpQueueActions',
    on: settings.allowCpQueueActions,
    instructions: 'When ON, the Control Panel may queue safe migration stages. Long-running stages still run through Craft queue jobs, not inline web requests.'|t('kunstmaan-migrator'),
}) }}

{{ forms.lightswitchField({
    label: 'Allow CP live queue action'|t('kunstmaan-migrator'),
    id: 'allowCpLiveQueueAction',
    name: 'allowCpLiveQueueAction',
    on: settings.allowCpLiveQueueAction,
    instructions: 'Default OFF. Live migration from the Control Panel remains blocked unless this is enabled and every live gate passes.'|t('kunstmaan-migrator'),
}) }}

        </section>

        <section id="km-settings-adapters" class="km-settings-section">
            <h2>{{ 'Adapters'|t('kunstmaan-migrator') }}</h2>

{{ forms.lightswitchField({
    label: 'Enable SEOmatic adapter'|t('kunstmaan-migrator'),
    id: 'seoEnabled',
    name: 'seoEnabled',
    on: settings.seoEnabled,
    instructions: 'When OFF, SEOmatic migration is skipped even if the plugin is installed. CLI --no-seo can still bypass per run.'|t('kunstmaan-migrator'),
}) }}

{{ forms.lightswitchField({
    label: 'Enable Retour adapter'|t('kunstmaan-migrator'),
    id: 'retourEnabled',
    name: 'retourEnabled',
    on: settings.retourEnabled,
    instructions: 'When OFF, Retour redirect migration is skipped even if the plugin is installed. CLI --no-retour can still bypass per run.'|t('kunstmaan-migrator'),
}) }}

        </section>

        <section id="km-settings-retention" class="km-settings-section">
            <h2>{{ 'Retention'|t('kunstmaan-migrator') }}</h2>

{{ forms.textField({
    label: 'Run record retention days'|t('kunstmaan-migrator'),
    id: 'runRecordRetentionDays',
    name: 'runRecordRetentionDays',
    type: 'number',
    value: settings.runRecordRetentionDays,
    min: 1,
    instructions: 'Default number of days to keep CP migration run records before future cleanup actions.'|t('kunstmaan-migrator'),
}) }}

{{ forms.textField({
    label: 'Artifact retention days'|t('kunstmaan-migrator'),
    id: 'artifactRetentionDays',
    name: 'artifactRetentionDays',
    type: 'number',
    value: settings.artifactRetentionDays,
    min: 1,
    instructions: 'Default number of days to keep migration logs and artifacts under storage/migration before future cleanup actions.'|t('kunstmaan-migrator'),
}) }}

        </section>
    </div>
</div>
