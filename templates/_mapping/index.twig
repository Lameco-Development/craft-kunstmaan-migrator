{% set title = 'Kunstmaan Mapping' %}
{% set selectedUrl = url('utilities/kunstmaan-mapping', {tab: 'mapping'}) %}

<style>
    .km-map-summary {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin: 12px 0 24px;
    }
    .km-map-badge {
        border-radius: 999px;
        background: #eef0f2;
        padding: 3px 10px;
        font-size: 12px;
    }
    .km-map-row {
        border: 1px solid #d7dce2;
        border-radius: 6px;
        margin-bottom: 16px;
        padding: 16px;
        background: #fff;
    }
    .km-map-row__head {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 12px;
    }
    .km-map-row__summary {
        font-weight: 600;
    }
    .km-map-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
        margin-top: 12px;
    }
    .km-map-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: end;
        margin-top: 12px;
    }
    .km-map-filter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 12px;
        align-items: end;
        margin-bottom: 16px;
    }
    .km-map-batch {
        border: 1px solid #d7dce2;
        border-radius: 6px;
        padding: 16px;
        margin: 16px 0;
        background: #fff;
    }
    .km-map-finding {
        border-left: 4px solid #f3ba00;
        padding: 8px 12px;
        margin: 12px 0;
        background: #fff8e5;
    }
    .km-map-finding--fatal,
    .km-map-finding--unsupported {
        border-left-color: #cf1124;
        background: #fff0f1;
    }
    .km-map-meta {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 8px;
        margin-top: 8px;
    }
    .km-map-muted {
        color: #596673;
    }
    .km-map-code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 12px;
    }
</style>

<form method="get" action="{{ selectedUrl }}" class="km-map-filter-grid">
    {{ hiddenInput('tab', 'mapping') }}
    <div class="field">
        <div class="heading">
            <label for="km-entity">Kunstmaan page entity</label>
        </div>
        <div class="input ltr">
            <div class="select">
                <select id="km-entity" name="entity">
                    {% for entity in entities %}
                        <option value="{{ entity }}"{{ entity == selectedEntity ? ' selected' }}>{{ entity }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
    </div>
    <div class="field">
        <div class="heading">
            <label for="km-status">Status</label>
        </div>
        <div class="input ltr">
            <div class="select">
                <select id="km-status" name="status">
                    {% for option in statusFilterOptions %}
                        <option value="{{ option }}"{{ option == statusFilter ? ' selected' }}>{{ option == 'all' ? 'All' : option|replace({'-': ' '})|title }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
    </div>
    <div class="field">
        <div class="heading">
            <label for="km-kind">Kind</label>
        </div>
        <div class="input ltr">
            <div class="select">
                <select id="km-kind" name="kind">
                    {% for option in kindFilterOptions %}
                        <option value="{{ option }}"{{ option == kindFilter ? ' selected' }}>{{ option == 'all' ? 'All' : option|replace({'pagePart': 'Page part', 'nodeClass': 'Node class', 'dataProvider': 'Data provider'})|title }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
    </div>
    <div class="field">
        <div class="heading">
            <label for="km-finding">Finding severity</label>
        </div>
        <div class="input ltr">
            <div class="select">
                <select id="km-finding" name="finding">
                    {% for option in findingFilterOptions %}
                        <option value="{{ option }}"{{ option == findingFilter ? ' selected' }}>{{ option == 'all' ? 'All' : (option == 'none' ? 'No findings' : option|title) }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
    </div>
    <div class="field">
        <div class="heading">
            <label for="km-q">Search source or target</label>
        </div>
        <div class="input ltr">
            <input id="km-q" class="text fullwidth" type="search" name="q" value="{{ searchQuery }}" placeholder="table, column, FQCN, target, handler">
        </div>
    </div>
    <div class="field">
        <button type="submit" class="btn submit">Apply filters</button>
        <a class="btn" href="{{ selectedUrl }}">Clear filters</a>
    </div>
</form>

<p class="km-map-muted">
    Editing saves directly to <code>{{ mappingPath }}</code>. This first CP version keeps the rows structured and focused:
    review, accept/drop, and adjust target handles.
</p>

{% if summaryCounts %}
    <div class="km-map-summary">
        {% for status, count in summaryCounts %}
            <span class="km-map-badge">{{ status }}: {{ count }}</span>
        {% endfor %}
    </div>
{% endif %}

{% if not selectedEntity %}
    <p>No page entities were found in mapping.yaml. Run analyze/compile first.</p>
{% elseif indexedRows is empty %}
    <p>No rows match the current filters. Clear filters to view all mapping rows.</p>
{% else %}
    <datalist id="km-sections">
        {% for value in targetOptions.sections %}<option value="{{ value }}">{% endfor %}
    </datalist>
    <datalist id="km-entry-types">
        {% for value in targetOptions.entryTypes %}<option value="{{ value }}">{% endfor %}
    </datalist>
    <datalist id="km-fields">
        {% for value in targetOptions.fieldHandles %}<option value="{{ value }}">{% endfor %}
    </datalist>
    <datalist id="km-matrix-fields">
        {% for value in targetOptions.matrixFields %}<option value="{{ value }}">{% endfor %}
    </datalist>
    <datalist id="km-block-types">
        {% for value in targetOptions.blockTypes %}<option value="{{ value }}">{% endfor %}
    </datalist>
    <datalist id="km-handlers">
        {% for value in targetOptions.handlers %}<option value="{{ value }}">{% endfor %}
    </datalist>

    <form id="km-map-batch" method="post" class="km-map-batch">
        {{ csrfInput() }}
        {{ actionInput('kunstmaan-migrator/mapping/batch') }}
        {{ hiddenInput('entity', selectedEntity) }}
        {{ hiddenInput('status', statusFilter) }}
        {{ hiddenInput('kind', kindFilter) }}
        {{ hiddenInput('finding', findingFilter) }}
        {{ hiddenInput('q', searchQuery) }}
        {{ hiddenInput('tab', 'mapping') }}

        <div class="km-map-actions">
            <div>
                <label for="km-batch-action">Batch action</label>
                <div class="select">
                    <select id="km-batch-action" name="batchAction">
                        <option value="accept">Accept selected</option>
                        <option value="needs-review">Mark needs review</option>
                        <option value="drop">Drop selected</option>
                        <option value="accept-warnings">Accept warnings explicitly</option>
                    </select>
                </div>
            </div>
            <div>
                <label for="km-batch-confirmation">Confirmation</label>
                <input id="km-batch-confirmation" class="text" name="confirmation" placeholder="Required for risky actions">
                <p class="instructions">Type <code>DROP SELECTED</code> to drop rows or <code>ACCEPT WARNINGS</code> to accept warning/unsupported rows.</p>
            </div>
            <div>
                <label for="km-batch-rationale">Batch rationale</label>
                <input id="km-batch-rationale" class="text" name="rationale" placeholder="Optional audit note">
            </div>
            <button type="submit" class="btn">Apply to selected rows</button>
        </div>
    </form>

    {% for item in indexedRows %}
        {% set row = item.row %}
        {% set kind = row.kind ?? 'column' %}
        {% set firstFinding = (row.findings ?? [])|first %}
        {% set findingSeverity = row.findingSeverity ?? row.severity ?? ((row.status ?? '') in ['warning', 'unsupported'] ? row.status : (firstFinding.severity ?? 'none')) %}
        {% set findingRationale = row.rationale ?? firstFinding.message ?? firstFinding.reason ?? '' %}
        {% if kind == 'nodeClass' or kind == 'taxonomy' %}
            {% set sourceSummary = row.fqcn ?? '' %}
            {% set targetSummary = ((row.targetSection ?? '') ~ '.' ~ (row.targetEntryType ?? ''))|trim('.') %}
            {% set handlerSummary = 'section mapping' %}
        {% elseif kind == 'dataProvider' %}
            {% set sourceSummary = row.fqcn ?? row.sourceTable ?? '' %}
            {% set targetSummary = row.target ?? '' %}
            {% set handlerSummary = 'dataProvider' %}
        {% elseif kind == 'pagePart' %}
            {% set sourceSummary = (row.pagePartClass ?? '') ~ ' / ' ~ (row.context ?? '') %}
            {% set targetSummary = ((row.targetEntryType ?? '') ~ '.' ~ (row.targetMatrixField ?? '') ~ ':' ~ (row.targetBlockType ?? ''))|trim('.:') %}
            {% set handlerSummary = 'matrix' %}
        {% else %}
            {% set sourceSummary = (row.table ?? '') ~ '.' ~ (row.column ?? '') %}
            {% set targetSummary = ((row.targetEntryType ?? '') ~ '.' ~ (row.targetHandle ?? ''))|trim('.') %}
            {% set handlerSummary = row.handler ?? '' %}
        {% endif %}
        <section class="km-map-row">
            <div class="km-map-row__head">
                <div>
                    <div class="km-map-row__summary">{{ item.summary }}</div>
                    <div class="km-map-muted km-map-code">
                        row #{{ item.index }} · kind: {{ kind }} · status: {{ row.status ?? 'unknown' }}
                    </div>
                    <div class="km-map-meta">
                        <div><strong>Source:</strong> <span class="km-map-code">{{ sourceSummary }}</span></div>
                        <div><strong>Target:</strong> <span class="km-map-code">{{ targetSummary ?: 'not mapped' }}</span></div>
                        <div><strong>Handler:</strong> <span class="km-map-code">{{ handlerSummary ?: 'none' }}</span></div>
                        <div><strong>Finding severity:</strong> {{ findingSeverity ?: 'none' }}</div>
                    </div>
                </div>
                <label>
                    <input type="checkbox" name="selectedRows[]" value="{{ item.index }}" form="km-map-batch">
                    Select
                </label>
                <form method="post" class="km-map-actions">
                    {{ csrfInput() }}
                    {{ actionInput('kunstmaan-migrator/mapping/set-status') }}
                    {{ hiddenInput('rowIndex', item.index) }}
                    {{ hiddenInput('entity', selectedEntity) }}
                    {{ hiddenInput('filterStatus', statusFilter) }}
                    {{ hiddenInput('filterKind', kindFilter) }}
                    {{ hiddenInput('filterFinding', findingFilter) }}
                    {{ hiddenInput('filterQ', searchQuery) }}
                    <input type="hidden" name="status" value="accepted">
                    <button type="submit" class="btn small submit">Accept</button>
                </form>
            </div>

            {% if findingSeverity != 'none' or findingRationale %}
                <div class="km-map-finding km-map-finding--{{ findingSeverity }}">
                    <strong>{{ findingSeverity == 'none' ? 'Rationale' : findingSeverity|title ~ ' finding' }}:</strong>
                    {{ findingRationale ?: 'Review this row before editing target controls.' }}
                </div>
            {% endif %}

            <form method="post">
                {{ csrfInput() }}
                {{ actionInput('kunstmaan-migrator/mapping/save-target') }}
                {{ hiddenInput('rowIndex', item.index) }}
                {{ hiddenInput('kind', kind) }}
                {{ hiddenInput('entity', selectedEntity) }}
                {{ hiddenInput('filterStatus', statusFilter) }}
                {{ hiddenInput('filterKind', kindFilter) }}
                {{ hiddenInput('filterFinding', findingFilter) }}
                {{ hiddenInput('filterQ', searchQuery) }}

                {% if kind == 'nodeClass' or kind == 'taxonomy' %}
                    <div class="km-map-grid">
                        <div>
                            <label>Source</label>
                            <input class="text fullwidth" readonly value="{{ row.fqcn ?? '' }}">
                        </div>
                        <div>
                            <label>Target section</label>
                            <input class="text fullwidth" name="targetSection" list="km-sections" value="{{ row.targetSection ?? '' }}">
                        </div>
                        <div>
                            <label>Target entry type</label>
                            <input class="text fullwidth" name="targetEntryType" list="km-entry-types" value="{{ row.targetEntryType ?? '' }}">
                        </div>
                    </div>
                {% elseif kind == 'pagePart' %}
                    <div class="km-map-grid">
                        <div>
                            <label>Page part</label>
                            <input class="text fullwidth" readonly value="{{ row.pagePartClass ?? '' }}">
                        </div>
                        <div>
                            <label>Context</label>
                            <input class="text fullwidth" readonly value="{{ row.context ?? '' }}">
                        </div>
                        <div>
                            <label>Target entry type</label>
                            <input class="text fullwidth" name="targetEntryType" list="km-entry-types" value="{{ row.targetEntryType ?? '' }}">
                        </div>
                        <div>
                            <label>Matrix field</label>
                            <input class="text fullwidth" name="targetMatrixField" list="km-matrix-fields" value="{{ row.targetMatrixField ?? '' }}">
                        </div>
                        <div>
                            <label>Block type</label>
                            <input class="text fullwidth" name="targetBlockType" list="km-block-types" value="{{ row.targetBlockType ?? '' }}">
                        </div>
                    </div>
                    {% if row.fields ?? [] %}
                        <p class="km-map-muted km-map-code">
                            Fields:
                            {% for field in row.fields %}
                                {{ field.targetHandle ?? '' }} ← {{ field.sourceProperty ?? '' }}{% if not loop.last %}, {% endif %}
                            {% endfor %}
                        </p>
                    {% endif %}
                {% else %}
                    <div class="km-map-grid">
                        <div>
                            <label>Source table.column</label>
                            <input class="text fullwidth" readonly value="{{ (row.table ?? '') ~ '.' ~ (row.column ?? '') }}">
                        </div>
                        <div>
                            <label>Target entry type</label>
                            <input class="text fullwidth" name="targetEntryType" list="km-entry-types" value="{{ row.targetEntryType ?? '' }}">
                        </div>
                        <div>
                            <label>Target handle</label>
                            <input class="text fullwidth" name="targetHandle" list="km-fields" value="{{ row.targetHandle ?? '' }}">
                        </div>
                        <div>
                            <label>Handler</label>
                            <input class="text fullwidth" name="handler" list="km-handlers" value="{{ row.handler ?? '' }}">
                        </div>
                    </div>
                    {% if row.samples ?? [] %}
                        <p class="km-map-muted km-map-code">Samples: {{ row.samples|slice(0, 3)|json_encode }}</p>
                    {% endif %}
                {% endif %}

                <div class="km-map-actions">
                    <button type="submit" class="btn submit">Save target + accept</button>
                </div>
            </form>

            <form method="post" class="km-map-actions">
                {{ csrfInput() }}
                {{ actionInput('kunstmaan-migrator/mapping/set-status') }}
                {{ hiddenInput('rowIndex', item.index) }}
                {{ hiddenInput('entity', selectedEntity) }}
                {{ hiddenInput('filterStatus', statusFilter) }}
                {{ hiddenInput('filterKind', kindFilter) }}
                {{ hiddenInput('filterFinding', findingFilter) }}
                {{ hiddenInput('filterQ', searchQuery) }}
                <input type="hidden" name="status" value="dropped">
                <input class="text" name="rationale" placeholder="Drop rationale" value="{{ row.rationale ?? '' }}">
                <button type="submit" class="btn small">Drop</button>
            </form>
        </section>
    {% endfor %}
{% endif %}
