{% set tabs = tabs ?? [] %}
{% set activeTab = activeTab ?? 'readiness' %}

<nav aria-label="Kunstmaan Migration Console tabs">
    <ul class="km-console-tabs">
        {% for tab in tabs %}
            <li>
                <a href="{{ tab.url }}" class="{{ tab.selected ? 'sel' : '' }}" aria-current="{{ tab.selected ? 'page' : 'false' }}">
                    {{ tab.label }}
                </a>
            </li>
        {% else %}
            {% for id, label in {
                readiness: 'Readiness',
                analyze: 'Analyze',
                mapping: 'Mapping',
                compile: 'Compile',
                runs: 'Runs',
                reports: 'Reports',
                danger: 'Danger Zone'
            } %}
                <li>
                    <a href="?tab={{ id }}" class="{{ activeTab == id ? 'sel' : '' }}" aria-current="{{ activeTab == id ? 'page' : 'false' }}">
                        {{ label }}
                    </a>
                </li>
            {% endfor %}
        {% endfor %}
    </ul>
</nav>
