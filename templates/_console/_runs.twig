{% set runs = runs ?? [] %}
{% set latestRun = latestRun ?? null %}
{% set cliCommands = cliCommands ?? {} %}
{% set liveGates = liveGates ?? [] %}
{% set runActions = runActions ?? {} %}
{% set liveBlocked = (liveGates|filter(g => (g.blocking ?? false) or (g.status ?? '') in ['blocked', 'unknown'])|length) > 0 %}
{% set runId = craft.app.request.getQueryParam('runId') ?? null %}
{% set matchingRuns = runId ? (runs|filter(r => (r.id ?? '') == runId)) : [] %}
{% set selectedRun = matchingRuns|first|default(null) %}
{% if selectedRun is empty and runId and latestRun and (latestRun.id ?? '') == runId %}
    {% set selectedRun = latestRun %}
{% endif %}

{% if selectedRun %}
    {% include 'kunstmaan-migrator/_console/_run-detail' with {run: selectedRun, copy: copy ?? {}, cliCommands: cliCommands} only %}
{% else %}
    <section class="pane">
        <h2>Runs</h2>
        <p class="km-console-muted">First-class migration run records with queue job IDs, progress, logs, artifacts, and retry actions.</p>

        {% if runs is empty %}
            <div class="zilch">
                <h3>No migration runs yet</h3>
                <p>Queue a dry run after readiness checks pass, or run the equivalent CLI command from your terminal.</p>
            </div>
        {% else %}
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>Run ID</th>
                        <th>Stage</th>
                        <th>Mode</th>
                        <th>Status</th>
                        <th>Filters</th>
                        <th>Initiated by</th>
                        <th>Queue job IDs</th>
                        <th>Progress</th>
                        <th>Started</th>
                        <th>Finished</th>
                        <th>Artifacts</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for run in runs %}
                        <tr>
                            <td>{{ run.id ?? '—' }}</td>
                            <td>{{ run.stage ?? '—' }}</td>
                            <td>{{ run.mode ?? '—' }}</td>
                            <td><span class="km-console-status km-console-status--{{ run.status ?? 'unknown' }}">{{ run.status ?? 'unknown' }}</span></td>
                            <td><code class="km-console-code">{{ run.filters|default({})|json_encode }}</code></td>
                            <td>{{ run.initiatedByUserId ?? run.initiatedBy ?? '—' }}</td>
                            <td><code class="km-console-code">{{ run.queueJobIds|default(run.queueJobId ?? [])|json_encode }}</code></td>
                            <td>{{ run.progress ?? 0 }}%</td>
                            <td>{{ run.dateStarted ?? run.startedAt ?? '—' }}</td>
                            <td>{{ run.dateFinished ?? run.finishedAt ?? '—' }}</td>
                            <td>{{ run.artifactPaths|default([])|join(', ') ?: '—' }}</td>
                            <td>
                                <a href="?tab=runs&amp;runId={{ run.id ?? '' }}">View details</a><br>
                                <a href="{{ run.logPath ?? '#' }}">View log</a><br>
                                <a href="?tab=reports&amp;runId={{ run.id ?? '' }}">View artifacts</a><br>
                                <button type="button" class="btn small" data-cli="{{ run.cliCommand ?? cliCommands.dryRun ?? './craft kunstmaan-migrator/migrate --dry-run' }}">Copy CLI command</button><br>
                                <span class="km-console-muted">Retry safe stage</span>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        <section class="km-console-warning-panel">
            <h3>Queue live migration</h3>
            <p>This live migration panel is visually separated from dry-run controls. Live remains disabled when any gate is blocked or unknown.</p>
            {% if liveBlocked %}
                <p class="error">This action cannot start because one or more safety gates failed. Review the failed gates below, fix the issue, then try again or use the shown CLI command.</p>
            {% endif %}
            {% if liveGates|filter(g => (g.id ?? '') == 'queue-worker-readiness' and (g.status ?? '') == 'unknown')|length %}
                <p class="error">Queue readiness could not be verified. Live migration is blocked from the Control Panel; use the CLI after confirming a worker is running.</p>
            {% endif %}

            <form method="post" class="km-console-actions">
                {{ csrfInput() }}
                {{ actionInput(runActions.live.action ?? 'kunstmaan-migrator/migration-console/queue-live') }}
                <label>
                    <input type="checkbox" name="backupAcknowledged" value="1">
                    I have a restorable database and asset backup for this environment.
                </label>
                <label>
                    <input type="checkbox" name="warningsAccepted" value="1">
                    I understand selected warning/unsupported mapping rows may be skipped, dropped, or migrated imperfectly.
                </label>
                <label>
                    Type <code>MIGRATE LIVE</code>
                    <input class="text" name="confirmation" placeholder="MIGRATE LIVE">
                </label>
                <button type="submit" class="btn error"{{ liveBlocked ? ' disabled' }}>Queue live migration</button>
                <span class="instructions">Equivalent CLI: <code>{{ cliCommands.live ?? './craft kunstmaan-migrator/migrate --live' }}</code></span>
            </form>

            <h4>Live gates</h4>
            <ul class="km-console-gates">
                {% for gate in liveGates %}
                    <li class="km-console-gate" data-gate="{{ gate.id ?? '' }}">
                        <strong>{{ gate.label ?? gate.id ?? 'Live gate' }}</strong>
                        <span class="km-console-status km-console-status--{{ gate.status ?? 'unknown' }}">{{ (gate.status ?? 'unknown')|title }}</span>
                        <div>{{ gate.message ?? '' }}</div>
                    </li>
                {% else %}
                    {% for gateId in ['non-production', 'admin', 'elevated-session', 'typed-confirmation', 'successful-dry-run-same-options', 'recent-compile-no-fatals', 'queue-worker-readiness', 'backup-acknowledgement', 'mapping-coverage', 'warning-unsupported-acceptance'] %}
                        <li class="km-console-gate" data-gate="{{ gateId }}"><strong>{{ gateId }}</strong> <span class="km-console-status km-console-status--unknown">Unknown</span></li>
                    {% endfor %}
                {% endfor %}
            </ul>
        </section>
    </section>
{% endif %}
