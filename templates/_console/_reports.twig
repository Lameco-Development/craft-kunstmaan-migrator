{% set reports = reports ?? [] %}
{% set runActions = runActions ?? {} %}
{% set cliCommands = cliCommands ?? {} %}

<section class="pane">
    <h2>Reports</h2>
    <p>Existing reports and artifacts remain visible under storage/migration, including REPORT.md, VERIFY-, PAGE-ROOTED-COVERAGE.md, MAPPING-AUDIT.md, kunstmaan-schema.json, craft-schema.json, and run-specific artifact paths.</p>

    <form method="post" class="km-console-actions">
        {{ csrfInput() }}
        {{ actionInput(runActions.verify.action ?? 'kunstmaan-migrator/migration-console/queue-verify') }}
        <button type="submit" class="btn submit">{{ runActions.verify.label ?? 'Queue verify/report' }}</button>
        <span class="instructions">Job queued. Progress will appear in the current run record. Equivalent CLI: <code>{{ cliCommands.verify ?? './craft kunstmaan-migrator/verify' }}</code></span>
    </form>

    <table class="data fullwidth">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Modified</th>
                <th>Associated run</th>
                <th>Artifact paths</th>
                <th>Action link</th>
            </tr>
        </thead>
        <tbody>
            {% for report in reports %}
                <tr>
                    <td><code>{{ report.name }}</code></td>
                    <td>{{ report.type }}</td>
                    <td>{{ report.modified ?? '—' }}</td>
                    <td>{{ report.runId ?? '—' }}</td>
                    <td><code>{{ report.path }}</code></td>
                    <td><a href="{{ report.path }}">Open artifact</a></td>
                </tr>
            {% else %}
                {% for name in ['REPORT.md', 'VERIFY-', 'PAGE-ROOTED-COVERAGE.md', 'MAPPING-AUDIT.md', 'kunstmaan-schema.json', 'craft-schema.json'] %}
                    <tr>
                        <td><code>{{ name }}</code></td>
                        <td>artifact</td>
                        <td>—</td>
                        <td>—</td>
                        <td><code>storage/migration/{{ name }}</code></td>
                        <td>Awaiting generated artifact</td>
                    </tr>
                {% endfor %}
            {% endfor %}
        </tbody>
    </table>
</section>
