{% set compileSummary = compileSummary ?? {} %}
{% set compileGates = compileGates ?? {} %}
{% set runActions = runActions ?? {} %}
{% set cliCommands = cliCommands ?? {} %}
{% set readiness = compileGates.compileReadiness ?? [] %}
{% set compileBlocked = (readiness|filter(g => g.blocking ?? false)|length) > 0 %}

<section class="pane">
    <h2>Compile</h2>
    <div class="km-console-grid">
        <div>
            <h3>Latest compile summary</h3>
            <dl class="data">
                <dt>latest compile timestamp</dt><dd>{{ compileSummary.timestamp ?? 'Unknown' }}</dd>
                <dt>Status</dt><dd>{{ compileSummary.status ?? 'Unknown' }}</dd>
                <dt>fatal warnings</dt><dd>{{ compileSummary.fatalWarningCount ?? 0 }}</dd>
                <dt>Warning count</dt><dd>{{ compileSummary.warningCount ?? 0 }}</dd>
                <dt>Artifact paths</dt><dd>{{ (compileSummary.artifactPaths ?? [])|join(', ') ?: 'No compile artifacts recorded under storage/migration.' }}</dd>
                <dt>Link to logs/report</dt><dd>{{ compileSummary.logReportLink ?? 'No log/report link recorded.' }}</dd>
            </dl>
        </div>
        <div>
            <h3>Compile readiness</h3>
            <ul class="km-console-gates">
                {% for gate in readiness %}
                    <li class="km-console-gate">
                        <strong>{{ gate.label }}</strong>
                        <span class="km-console-status km-console-status--{{ gate.status ?? 'unknown' }}">{{ (gate.status ?? 'unknown')|title }}</span>
                        <div>{{ gate.message ?? '' }}</div>
                    </li>
                {% else %}
                    <li>Mapping file exists, mapping coverage, Craft target drift, and unsupported rows will appear here when the gate service is available.</li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <form method="post" class="km-console-actions">
        {{ csrfInput() }}
        {{ actionInput(runActions.compile.action ?? 'kunstmaan-migrator/migration-console/queue-compile') }}
        <label>
            <input type="checkbox" name="overwrite" value="1" checked>
            Regenerate compiled mapping blocks if they already exist.
        </label>
        <button type="submit" class="btn submit"{{ compileBlocked ? ' disabled' }}>{{ runActions.compile.label ?? 'Queue compile' }}</button>
        <span class="instructions">equivalent CLI command: <code>{{ (cliCommands.compile ?? './craft kunstmaan-migrator/compile') ~ ' --overwrite' }}</code></span>
    </form>
</section>
