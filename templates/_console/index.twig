{% set title = title ?? 'Kunstmaan Migration Console' %}
{% set subtitle = subtitle ?? 'Review readiness, mapping coverage, queued runs, logs, and artifacts for the Kunstmaan → Craft migration. CLI remains the canonical workflow.' %}
{% set tabs = tabs ?? [] %}
{% set activeTab = activeTab ?? 'readiness' %}

<div class="km-console">
    <style>
        .km-console-header { margin-bottom: 24px; }
        .km-console-subtitle { max-width: 920px; color: #596673; }
        .km-console-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 24px; padding: 0; list-style: none; }
        .km-console-tabs a { display: inline-block; padding: 8px 12px; border-radius: 4px; text-decoration: none; }
        .km-console-tabs a.sel { background: #0d78f2; color: #fff; }
        .km-console-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; }
        .km-console-card { margin-bottom: 24px; }
        .km-console-card__heading { display: flex; justify-content: space-between; gap: 16px; align-items: start; }
        .km-console-gates { margin: 16px 0 0; padding: 0; list-style: none; }
        .km-console-gate { border-top: 1px solid #d7dce2; padding: 8px 0; }
        .km-console-status { display: inline-block; border-radius: 999px; padding: 2px 9px; background: #eef0f2; font-size: 12px; font-weight: 600; }
        .km-console-status--passed { background: #e6f6e8; color: #1f7a31; }
        .km-console-status--warning { background: #fff8e5; color: #8a5a00; }
        .km-console-status--blocked { background: #fff0f1; color: #cf1124; }
        .km-console-status--unknown { background: #eef0f2; color: #596673; }
        .km-console-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: end; margin-top: 16px; }
        .km-console-form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; align-items: end; }
        .km-console-code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px; white-space: pre-wrap; }
        .km-console-muted { color: #596673; }
        .km-console-warning-panel { border-left: 4px solid #cf1124; background: #fff0f1; padding: 16px; margin-top: 32px; }
    </style>

    <header class="km-console-header">
        <h1>{{ title }}</h1>
        <p class="km-console-subtitle">{{ subtitle }}</p>
        <p class="notice">{{ copy.cliFallbackIntro ?? 'Use the CLI when you need full debug output, production safety verification, or a gate cannot be verified from the Control Panel.' }}</p>
    </header>

    {% include 'kunstmaan-migrator/_console/_tabs' ignore missing with {
        tabs: tabs,
        activeTab: activeTab,
    } only %}

    {% if activeTab == 'analyze' %}
        {% include 'kunstmaan-migrator/_console/_analyze' with _context %}
    {% elseif activeTab == 'mapping' %}
        {% include 'kunstmaan-migrator/_console/_mapping' ignore missing with _context %}
    {% elseif activeTab == 'compile' %}
        {% include 'kunstmaan-migrator/_console/_compile' with _context %}
    {% elseif activeTab == 'runs' %}
        {% include 'kunstmaan-migrator/_console/_runs' ignore missing with _context %}
    {% elseif activeTab == 'reports' %}
        {% include 'kunstmaan-migrator/_console/_reports' ignore missing with _context %}
    {% elseif activeTab == 'danger' %}
        {% include 'kunstmaan-migrator/_console/_danger-zone' ignore missing with _context %}
    {% else %}
        {% include 'kunstmaan-migrator/_console/_readiness' with _context %}
    {% endif %}
</div>
