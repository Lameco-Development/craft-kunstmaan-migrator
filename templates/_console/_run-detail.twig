{% set run = run ?? {} %}
{% set copy = copy ?? {} %}

<section class="pane">
    <h2>Run {{ run.id ?? 'detail' }}</h2>
    <dl class="data">
        <dt>Stage</dt><dd>{{ run.stage ?? '—' }}</dd>
        <dt>Mode</dt><dd>{{ run.mode ?? '—' }}</dd>
        <dt>Status</dt><dd>{{ run.status ?? '—' }}</dd>
        <dt>Progress</dt><dd>{{ run.progress ?? 0 }}%</dd>
        <dt>Initiating admin</dt><dd>{{ run.initiatedByUserId ?? run.initiatedBy ?? '—' }}</dd>
        <dt>Queue job IDs</dt><dd><code class="km-console-code">{{ run.queueJobIds|default(run.queueJobId ?? [])|json_encode }}</code></dd>
        <dt>Started</dt><dd>{{ run.dateStarted ?? run.startedAt ?? '—' }}</dd>
        <dt>Finished</dt><dd>{{ run.dateFinished ?? run.finishedAt ?? '—' }}</dd>
    </dl>

    <h3>Gate snapshot</h3>
    {% if run.gateSnapshot ?? [] %}
        <ul class="km-console-gates">
            {% for gate in run.gateSnapshot %}
                <li class="km-console-gate"><strong>{{ gate.label ?? gate.id ?? 'gate' }}</strong> — {{ gate.status ?? 'unknown' }} — {{ gate.message ?? '' }}</li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="km-console-muted">No gate snapshot was recorded for this run.</p>
    {% endif %}

    <h3>Filters/options</h3>
    <pre class="km-console-code">{{ {filters: run.filters|default({}), options: run.options|default({})}|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>

    <h3>Log excerpt</h3>
    {% if run.logExcerpt ?? '' %}
        <pre class="km-console-code">{{ run.logExcerpt }}</pre>
    {% else %}
        <p>No log lines have been written for this run yet. Refresh after the queue worker starts processing.</p>
    {% endif %}

    <h3>Artifacts</h3>
    {% if run.artifactPaths ?? [] %}
        <ul>{% for path in run.artifactPaths %}<li><code>{{ path }}</code></li>{% endfor %}</ul>
    {% else %}
        <p>No artifacts have been recorded for this run yet. Artifacts are written under storage/migration.</p>
    {% endif %}

    <h3>Failure details</h3>
    <p>{{ run.failure ?? 'No failure details recorded.' }}</p>

    <h3>Readable summary</h3>
    {% if run.summary ?? [] %}
        <dl class="data">
            {% for key, value in run.summary %}
                <dt>{{ key }}</dt><dd>{{ value is iterable ? value|json_encode : value }}</dd>
            {% endfor %}
        </dl>
    {% else %}
        <p class="km-console-muted">No readable summary has been recorded yet.</p>
    {% endif %}

    <details>
        <summary>Raw JSON</summary>
        <pre class="km-console-code">{{ run|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
    </details>
</section>
