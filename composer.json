{
    "name": "lameco/craft-kunstmaan-migrator",
    "description": "Thin payload loader for Kunstmaan→Craft migrations",
    "type": "craft-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Lameco Development",
            "email": "development@lameco.nl"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "craftcms/ckeditor": "^4.0 || ^5.0",
        "craftcms/cms": "^5.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/dotenv": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "suggest": {
        "nystudio107/craft-seomatic": "Enables the SEOmatic adapter (^5.1).",
        "nystudio107/craft-retour": "Enables the Retour adapter (^5.0)."
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "nystudio107/craft-retour": "^5.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0",
        "spicyweb/craft-embedded-assets": "^5.4",
        "verbb/formie": "^3.1",
        "verbb/navigation": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Lameco\\Kunstmaanmigrator\\": "src/",
            "Lameco\\KumaCompile\\": "lib/kuma-compile/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lameco\\Kunstmaanmigrator\\tests\\": "tests/",
            "Lameco\\KumaCompile\\Tests\\": "lib/kuma-compile/tests/",
            "Lameco\\Kunstmaanmigrator\\phpstan\\": "phpstan/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-unit": "vendor/bin/phpunit --testsuite Unit",
        "test-integration": "vendor/bin/phpunit --testsuite Integration",
        "test-coverage": [
            "@php -r \"if (!extension_loaded('pcov') && !extension_loaded('xdebug')) { fwrite(STDERR, 'install pcov or xdebug to run coverage' . PHP_EOL); exit(1); }\"",
            "vendor/bin/phpunit --coverage-clover=build/coverage/clover.xml",
            "@php tools/check-coverage.php"
        ],
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "check-cs": "vendor/bin/ecs check --ansi",
        "fix-cs": "vendor/bin/ecs check --ansi --fix",
        "check": [
            "@check-cs",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "handle": "kunstmaan-migrator",
        "name": "Laméco Kunstmaan Migrator",
        "class": "Lameco\\Kunstmaanmigrator\\Plugin",
        "schemaVersion": "1.1.0",
        "developer": "Laméco",
        "documentationUrl": "https://github.com/Lameco-Development/craft-kunstmaan-migrator#readme",
        "changelogUrl": "https://raw.githubusercontent.com/Lameco-Development/craft-kunstmaan-migrator/development/CHANGELOG.md"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "bin": [
        "lib/kuma-compile/bin/kuma-compile"
    ],
    "support": {
        "issues": "https://github.com/Lameco-Development/craft-kunstmaan-migrator/issues",
        "source": "https://github.com/Lameco-Development/craft-kunstmaan-migrator"
    }
}
