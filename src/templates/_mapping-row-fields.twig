{# The field map for the chosen target — included by _mapping-row and also
 rendered standalone by migration/field-map, so the Becomes dropdown can
 redraw it live instead of asking for a save first. #}
{% import "_includes/forms.twig" as forms %}
{% if fields is not empty %}
    <hr>

    <h2>{{ "Field map"|t('kunstmaan-migrator') }}</h2>
    <p class="light">
      {% if columns is not empty %}
        {{ "Each Craft field, and the old column that fills it."|t('kunstmaan-migrator') }}
      {% else %}
        {{ "The old database is not reachable, so type the column names by hand."|t('kunstmaan-migrator') }}
      {% endif %}
    </p>

    <table class="data fullwidth">
      <thead>
        <tr>
          <th>{{ "Craft field"|t('kunstmaan-migrator') }}</th>
          <th>{{ "Old column"|t('kunstmaan-migrator') }}</th>
          <th>{{ "Converted how"|t('kunstmaan-migrator') }}</th>
        </tr>
      </thead>
      <tbody>
        {% for field in fields %}
          {% set expression = expressions[field] %}
          {% set fills = sidecarFills[field] ?? [] %}
          <tr>
            <th scope="row">
              <code>{{ field }}</code>
              {# The sidecar fills this field on every page it decorates, and a
                 screen that shows it as "not filled" is lying. Named here, with
                 the way out — the page's own map wins a collision, so a column
                 chosen on this row is an override, not a conflict. #}
              {% for fill in fills %}
                <div class="light">
                  {{ "filled by the {sidecar} sidecar"|t('kunstmaan-migrator', { sidecar: fill.sidecar }) }}
                  (<code>{{ fill.expression }}</code>)
                  · <a href="{{ url('kunstmaan-migrator/mapping-row', { lane: 'sidecars', key: fill.sidecar }) }}">{{ "edit"|t('kunstmaan-migrator') }}</a>
                </div>
              {% endfor %}
              {# The compiler drops a field the page's type lacks and counts it —
                 hours later. The count belongs here, while it is cheap to act on. #}
              {% set fieldCarriage = carriage[field] ?? null %}
              {% if fieldCarriage %}
                {% if fieldCarriage.missing is empty %}
                  <div class="light">{{ "on every mapped entry type"|t('kunstmaan-migrator') }}</div>
                {% else %}
                  <div class="light warning-with-icon">
                    {% set shown = fieldCarriage.missing|slice(0, 5) %}
                    {{ "on {carried} of {total} mapped entry types — dropped on {missing}"|t('kunstmaan-migrator', {
                      carried: fieldCarriage.carried,
                      total: fieldCarriage.total,
                      missing: shown|join(', ') ~ (fieldCarriage.missing|length > 5
                        ? ' ' ~ "and {more} more"|t('kunstmaan-migrator', { more: fieldCarriage.missing|length - 5 })
                        : ''),
                    }) }}
                  </div>
                {% endif %}
              {% endif %}
            </th>

            {% if expression.isAdvanced() %}
              {# `link(link_url, title, link_new_window)` composes several
                 columns into one field and `ref(Entity)` names an entity, not
                 a column. Neither fits two dropdowns, and a form that
                 pretended otherwise would quietly drop the arguments. #}
              <td colspan="2">
                {{ forms.text({
                  name: 'map[' ~ field ~ '][advanced]',
                  value: expression.advanced,
                  class: 'code',
                }) }}
                <span class="light">{{ "Combines several columns. Edit only if you know the expression syntax."|t('kunstmaan-migrator') }}</span>
              </td>
            {% else %}
              <td>
                {% if columns is not empty %}
                  {{ forms.selectize({
                    name: 'map[' ~ field ~ '][column]',
                    value: expression.column,
                    options: [{
                      label: fills is not empty
                        ? "— the sidecar fills this —"|t('kunstmaan-migrator')
                        : "— not filled —"|t('kunstmaan-migrator'),
                      value: '',
                    }]|merge(
                      columns|map(c => { label: c, value: c })
                    ),
                  }) }}
                {% else %}
                  {{ forms.text({ name: 'map[' ~ field ~ '][column]', value: expression.column }) }}
                {% endif %}
              </td>
              <td>
                {{ forms.selectize({
                  name: 'map[' ~ field ~ '][transform]',
                  value: expression.transform,
                  options: [{ label: "As it is"|t('kunstmaan-migrator'), value: '' }]|merge(
                    transforms|keys|map(t => { label: transforms[t], value: t })
                  ),
                }) }}
              </td>
            {% endif %}
          </tr>
        {% endfor %}
      </tbody>
    </table>

    {% set unknown = row.map|keys|filter(f => f not in fields) %}
    {% if unknown is not empty %}
      <blockquote class="note warning">
        <p>
          {{ "The mapping fills fields this target does not have:"|t('kunstmaan-migrator') }}
          <code>{{ unknown|join('</code>, <code>')|raw }}</code>.
          {{ "Fix them in the mapping file, or pick a different target."|t('kunstmaan-migrator') }}
        </p>
      </blockquote>
    {% endif %}
{% endif %}
