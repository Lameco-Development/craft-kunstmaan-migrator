{% import "_includes/forms.twig" as forms %}

{% if isProduction %}
  <div class="readable">
    <blockquote class="note warning">
      <p>{{ "This is a production environment. The migrator refuses to run here."|t('kunstmaan-migrator') }}</p>
    </blockquote>
  </div>
{% endif %}

{% if notSetUp %}
  {# The normal state of a fresh install, so it reads as a starting point
     rather than as something already gone wrong. #}
  <div class="readable" style="text-align: center; padding: 30px 0;">
    <h2>{{ "Bring a Kunstmaan site into Craft"|t('kunstmaan-migrator') }}</h2>
    <p>
      {{ "Four questions: the old database, which sites migrate, and where each language and its files go. You review the result at the end."|t('kunstmaan-migrator') }}
    </p>
    <p style="margin-top: 18px;">
      <a class="btn submit big" href="{{ url('kunstmaan-migrator/setup') }}">{{ "Start"|t('kunstmaan-migrator') }}</a>
    </p>
    <p class="light">
      {{ "Nothing is written to the old site, and nothing is migrated until you say so."|t('kunstmaan-migrator') }}
    </p>
  </div>
{% elseif error %}
  <div class="readable">
    <blockquote class="note warning">
      <p>{{ "The mapping file could not be read:"|t('kunstmaan-migrator') }} {{ error }}</p>
    </blockquote>
  </div>
{% else %}

  <p class="light">
    <code>{{ mappingPath }}</code>
    &nbsp;<a class="btn small" href="{{ url('kunstmaan-migrator/mapping') }}">{{ "Edit mapping"|t('kunstmaan-migrator') }}</a>
  </p>

  <h2>{{ "Preflight"|t('kunstmaan-migrator') }}</h2>

  <table class="data fullwidth">
    <thead>
      <tr>
        <th>{{ "Environment"|t('kunstmaan-migrator') }}</th>
        <th>{{ "Database"|t('kunstmaan-migrator') }}</th>
        <th>{{ "Nodes"|t('kunstmaan-migrator') }}</th>
        <th>{{ "Findings"|t('kunstmaan-migrator') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for check in checks %}
        <tr>
          <th scope="row">
            {% if check.isBlocked %}
              <span data-icon="alert" class="error"></span>
            {% elseif check.isReady %}
              <span data-icon="check" class="success"></span>
            {% else %}
              <span data-icon="alert"></span>
            {% endif %}
            {{ check.name }}
          </th>
          <td><code>{{ check.database }}</code></td>
          <td>{{ check.nodeCount is null ? '—' : check.nodeCount|number_format }}</td>
          <td>
            {% for problem in check.problems %}
              <div class="{{ check.isBlocked ? 'error' : '' }}">{{ problem }}</div>
            {% else %}
              <span class="light">{{ "Ready"|t('kunstmaan-migrator') }}</span>
            {% endfor %}
            {% if check.localesNotMigrated %}
              <div class="light">
                {{ "Not migrating:"|t('kunstmaan-migrator') }} {{ check.localesNotMigrated|join(', ') }}
              </div>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

  <hr>

  <h2>{{ "Run"|t('kunstmaan-migrator') }}</h2>

  <p class="light">
    {{ "Reads the old site and writes into Craft. Can take hours, and is safe to stop and restart: migrated pages are skipped."|t('kunstmaan-migrator') }}
  </p>

  {{ forms.selectField({
    label: "Which sites"|t('kunstmaan-migrator'),
    id: 'kuma-environment',
    name: 'environment',
    options: [{ label: "All of them"|t('kunstmaan-migrator'), value: '' }]|merge(
      checks|map(c => { label: c.name, value: c.name })
    ),
  }) }}

  {{ forms.lightswitchField({
    label: "Practice run"|t('kunstmaan-migrator'),
    instructions: "Reports what a run would do, without writing anything."|t('kunstmaan-migrator'),
    id: 'kuma-dry-run',
    name: 'dryRun',
  }) }}

  {# Skipping is what makes a stopped run safe to resume, and it is also what makes a corrected
     mapping do nothing. This is the way to say "read it again anyway" — and it overwrites, so the
     warning is the point of the field, not decoration. #}
  {{ forms.lightswitchField({
    label: "Re-run and overwrite"|t('kunstmaan-migrator'),
    instructions: "Migrates already-migrated pages again, so a corrected mapping reaches them."|t('kunstmaan-migrator'),
    warning: "Re-migrates pages that are already in Craft and overwrites them, including anything editors changed. Only safe while nothing else edits this content."|t('kunstmaan-migrator'),
    id: 'kuma-force',
    name: 'force',
  }) }}

  <div class="field">
    <div class="input">
      <button type="button" class="btn submit big" id="kuma-queue">{{ "Start the migration"|t('kunstmaan-migrator') }}</button>
      <span id="kuma-queue-result" class="light" style="margin-inline-start: 8px;"></span>
    </div>
  </div>

  {# Live, because the alternative is a button that appears to do nothing for
     two hours. Craft's queue already knows the progress of every job; this just
     shows it where somebody is looking. #}
  <div id="kuma-progress" class="hidden">
    <h3>{{ "Running"|t('kunstmaan-migrator') }}</h3>
    <ul class="kuma-jobs" id="kuma-jobs"></ul>
    <p class="light" id="kuma-jobs-note">
      {{ "Leave this tab open, or run `craft queue/listen` in a terminal to keep it moving."|t('kunstmaan-migrator') }}
    </p>
  </div>

  <details style="margin-top: 22px;">
    <summary>{{ "If a run stopped part-way"|t('kunstmaan-migrator') }}</summary>
    <p class="light">
      {{ "A full run does all of these in order. Each is safe to repeat on its own."|t('kunstmaan-migrator') }}
    </p>
    <div class="btngroup">
      <button type="button" class="btn" data-pass="entries">{{ "Pages and content only"|t('kunstmaan-migrator') }}</button>
      <button type="button" class="btn" data-pass="fixup">{{ "Link pages to each other"|t('kunstmaan-migrator') }}</button>
      <button type="button" class="btn" data-pass="finalize">{{ "Fix links and images inside text"|t('kunstmaan-migrator') }}</button>
      <button type="button" class="btn" data-pass="uris">{{ "Settle page URLs"|t('kunstmaan-migrator') }}</button>
    </div>
  </details>

  {% js %}
    var isOn = function (id) {
      return document.getElementById(id).getAttribute('aria-checked') === 'true' ? 1 : 0;
    };

    var poll = null;

    // Craft's queue already knows what every job is doing. Showing it here is
    // the difference between "started" and two hours of nothing.
    var track = function () {
      Craft.sendActionRequest('POST', 'queue/get-job-info', { data: { limit: 50 } })
        .then(function (response) {
          var jobs = (response.data.jobs || []).filter(function (job) {
            return /Migrating |Linking pages|Fixing links/.test(job.description || '');
          });

          var list = document.getElementById('kuma-jobs');
          var panel = document.getElementById('kuma-progress');

          if (!jobs.length) {
            // Clear the list too. Leaving the last job on screen beside "the run
            // has finished" reads as though it is still going and finished at
            // the same time.
            list.innerHTML = '';
            document.getElementById('kuma-jobs-note').textContent =
              '{{ "Finished. Nothing left in the queue."|t('kunstmaan-migrator')|e('js') }}';
            clearInterval(poll);
            return;
          }

          panel.classList.remove('hidden');
          list.innerHTML = '';

          jobs.forEach(function (job) {
            var item = document.createElement('li');
            var failed = job.status === 4;
            item.className = 'kuma-job' + (failed ? ' kuma-job--failed' : '');
            item.innerHTML =
              '<div class="kuma-job__name">' + Craft.escapeHtml(job.description || '') + '</div>' +
              '<div class="kuma-job__bar"><span style="width: ' + (job.progress || 0) + '%"></span></div>' +
              '<div class="kuma-job__note light">' +
                Craft.escapeHtml(failed ? (job.error || 'Failed') : (job.progressLabel || '')) +
              '</div>';
            list.appendChild(item);
          });
        })
        .catch(function () { clearInterval(poll); });
    };

    var queue = function (pass, button) {
      var result = document.getElementById('kuma-queue-result');
      button.disabled = true;
      result.className = 'light';
      result.textContent = '{{ "Starting…"|t('kunstmaan-migrator')|e('js') }}';

      Craft.sendActionRequest('POST', 'kunstmaan-migrator/migration/queue', {
        data: {
          pass: pass,
          environment: document.getElementById('kuma-environment').value,
          dryRun: isOn('kuma-dry-run'),
          force: isOn('kuma-force')
        }
      })
        .then(function (response) {
          result.textContent = response.data.message;
          result.className = response.data.ok ? 'success' : 'error';

          if (response.data.ok) {
            Craft.cp.runQueue();
            document.getElementById('kuma-progress').classList.remove('hidden');
            track();
            clearInterval(poll);
            poll = setInterval(track, 2000);
          }
        })
        .catch(function (error) {
          result.textContent = (error.response && error.response.data && error.response.data.message)
            || '{{ "Could not reach Craft."|t('kunstmaan-migrator')|e('js') }}';
          result.className = 'error';
        })
        .finally(function () { button.disabled = false; });
    };

    // The button says what pressing it will do. A practice run and a real one
    // are not the same act, and one button labelled for both is how somebody
    // migrates a live site meaning to rehearse.
    var label = function () {
      var button = document.getElementById('kuma-queue');

      if (isOn('kuma-dry-run')) {
        button.textContent = '{{ "Start practice run"|t('kunstmaan-migrator')|e('js') }}';
      } else if (isOn('kuma-force')) {
        button.textContent = '{{ "Re-run and overwrite"|t('kunstmaan-migrator')|e('js') }}';
      } else {
        button.textContent = '{{ "Start the migration"|t('kunstmaan-migrator')|e('js') }}';
      }
    };

    // Craft's lightswitch emits `change`; listening for `click` misses the
    // keyboard and misses anything that flips it programmatically.
    $('#kuma-dry-run').on('change', label);
    $('#kuma-force').on('change', label);

    label();

    // Only the combination that overwrites asks. A practice run writes nothing, and a first run
    // has nothing to overwrite — prompting on those trains people to click through the prompt.
    var confirmed = function () {
      if (!isOn('kuma-force') || isOn('kuma-dry-run')) {
        return true;
      }

      return window.confirm(
        '{{ "This re-migrates pages that are already in Craft and overwrites them. Blocks are replaced, so any control-panel edits to them are lost. Continue?"|t('kunstmaan-migrator')|e('js') }}'
      );
    };

    document.getElementById('kuma-queue').addEventListener('click', function () {
      if (!confirmed()) {
        return;
      }

      queue('full', this);
    });

    document.querySelectorAll('[data-pass]').forEach(function (button) {
      button.addEventListener('click', function () {
        queue(this.getAttribute('data-pass'), this);
      });
    });

  {% endjs %}

{% endif %}

{% css %}
  .kuma-jobs { list-style: none; margin: 0; padding: 0; }
  .kuma-job { padding: 10px 0; border-bottom: 1px solid var(--hairline-color, #e3e5e8); }
  .kuma-job__name { font-weight: 600; }
  .kuma-job__bar {
    height: 6px; border-radius: 3px; margin: 6px 0 4px;
    background: var(--gray-200, #cdd8e4); overflow: hidden;
  }
  .kuma-job__bar span {
    display: block; height: 100%;
    background: var(--enabled-color, #27ab83);
    transition: width .3s ease;
  }
  .kuma-job--failed .kuma-job__bar span { background: var(--error-color, #cf1124); }
  .kuma-job__note { font-size: 12px; }
{% endcss %}
