{% extends "_layouts/cp.twig" %}
{% import "_includes/forms.twig" as forms %}

{% set title = "Set up a migration"|t('kunstmaan-migrator') %}
{% set crumbs = [{ label: "Databases"|t('kunstmaan-migrator'), url: url('kunstmaan-migrator/setup') }] %}
{% set fullPageForm = true %}

{% block content %}
  {{ actionInput('kunstmaan-migrator/setup/write') }}
  {{ redirectInput('kunstmaan-migrator/mapping') }}
  {{ hiddenInput('envs', envs) }}

  <div class="readable">
    <p>
      {{ "Each locale below is published content in the legacy database, with how many live pages it has. A locale with no Craft site is written down as a deliberate omission, with your reason — a run reports that differently from a locale nobody decided about."|t('kunstmaan-migrator') }}
    </p>
  </div>

  {% for label, environment in environments %}
    <h2>{{ label }} <span class="light"><code>{{ environment.database }}</code></span></h2>

    {{ forms.textareaField({
      label: "Uploads directory"|t('kunstmaan-migrator'),
      instructions: "Where this site's legacy uploads live on disk. One per line: an environment routinely falls back to another site's uploads for media that only ever lived there. `$VARIABLES` and Craft `@aliases` work, and are better than an absolute path in a file everyone shares."|t('kunstmaan-migrator'),
      name: 'mediaRoot[' ~ label ~ ']',
      rows: 2,
      placeholder: '$KUMA_MEDIA_ROOT_' ~ label|upper,
    }) }}

    <table class="data fullwidth">
      <thead>
        <tr>
          <th>{{ "Locale"|t('kunstmaan-migrator') }}</th>
          <th class="rightalign">{{ "Live pages"|t('kunstmaan-migrator') }}</th>
          <th>{{ "Writes to"|t('kunstmaan-migrator') }}</th>
          <th>{{ "…or why not"|t('kunstmaan-migrator') }}</th>
        </tr>
      </thead>
      <tbody>
        {% for locale, pages in environment.locales %}
          <tr>
            <th scope="row"><code>{{ locale }}</code></th>
            <td class="rightalign">{{ pages|number_format }}</td>
            <td>
              {{ forms.select({
                name: 'locales[' ~ label ~ '][' ~ locale ~ '][site]',
                options: [{ label: "— not migrated —"|t('kunstmaan-migrator'), value: '' }]|merge(
                  sites|map(s => { label: s.name ~ ' (' ~ s.handle ~ ')', value: s.handle })
                ),
              }) }}
            </td>
            <td>
              {{ forms.text({
                name: 'locales[' ~ label ~ '][' ~ locale ~ '][reason]',
                placeholder: "why this locale is not migrated"|t('kunstmaan-migrator'),
              }) }}
            </td>
          </tr>
        {% else %}
          <tr><td colspan="4" class="light">{{ "This database publishes nothing live."|t('kunstmaan-migrator') }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  {% endfor %}

  <hr>

  {{ forms.textField({
    label: "Kunstmaan checkout"|t('kunstmaan-migrator'),
    instructions: "Optional. With it, legacy entity classes resolve to their real table names; without it every table is left as a TODO for you to fill in."|t('kunstmaan-migrator'),
    name: 'source',
    placeholder: '/Users/you/Sites/legacy-site',
  }) }}
{% endblock %}
