{% extends "_layouts/cp.twig" %}
{% set selectedSubnavItem = 'mapping' %}
{% import "_includes/forms.twig" as forms %}

{% set title = "Mapping"|t('kunstmaan-migrator') %}

{% block content %}
  {% if error %}
    <div class="readable">
      <blockquote class="note warning"><p>{{ error }}</p></blockquote>
    </div>
  {% else %}
    <p class="light">
      <code>{{ path }}</code>
      <button type="button" class="btn small" id="kuma-check" style="margin-left: 8px;">{{ "Check mapping"|t('kunstmaan-migrator') }}</button>
    </p>
    <div id="kuma-check-results" class="readable" style="display: none; margin-bottom: 16px;"></div>

    {% js %}
      (function () {
        var button = document.getElementById('kuma-check');
        var results = document.getElementById('kuma-check-results');

        button.addEventListener('click', function () {
          button.classList.add('loading');
          Craft.sendActionRequest('POST', 'kunstmaan-migrator/migration/check').then(function (response) {
            var data = response.data;
            results.style.display = '';

            // A mapping can pass every gate and still carry warnings — a required field
            // nothing fills is the one that predicts a block arriving empty — so these
            // render alongside the verdict rather than only in place of it.
            var appendWarnings = function () {
              if (!data.warnings || !data.warnings.length) {
                return;
              }

              var note = document.createElement('blockquote');
              note.className = 'note';
              var title = document.createElement('p');
              title.innerHTML = '<strong></strong>';
              title.querySelector('strong').textContent = '{{ "Warnings"|t('kunstmaan-migrator')|e('js') }}';
              note.appendChild(title);

              var warnList = document.createElement('ul');
              data.warnings.forEach(function (warning) {
                var item = document.createElement('li');
                item.textContent = warning;
                warnList.appendChild(item);
              });
              note.appendChild(warnList);

              if (data.warningTotal > data.warnings.length) {
                var extra = document.createElement('p');
                extra.className = 'light';
                extra.textContent = '{{ "… and {more} more"|t('kunstmaan-migrator', { more: '###' })|e('js') }}'.replace('###', String(data.warningTotal - data.warnings.length));
                note.appendChild(extra);
              }

              results.appendChild(note);
            };

            if (data.ok) {
              results.innerHTML = '<blockquote class="note tip"><p></p></blockquote>';
              results.querySelector('p').textContent = data.summary;
              appendWarnings();
              return;
            }

            var box = document.createElement('blockquote');
            box.className = 'note warning';
            var head = document.createElement('p');
            head.innerHTML = '<strong></strong>';
            head.querySelector('strong').textContent = data.headline;
            box.appendChild(head);

            if (data.errors.length) {
              var list = document.createElement('ul');
              data.errors.forEach(function (error) {
                var item = document.createElement('li');
                item.textContent = error;
                list.appendChild(item);
              });
              box.appendChild(list);

              if (data.total > data.errors.length) {
                var more = document.createElement('p');
                more.className = 'light';
                more.textContent = '{{ "… and {more} more"|t('kunstmaan-migrator', { more: '###' })|e('js') }}'.replace('###', String(data.total - data.errors.length));
                box.appendChild(more);
              }
            }

            results.innerHTML = '';
            results.appendChild(box);
            appendWarnings();
          }).finally(function () {
            button.classList.remove('loading');
          });
        });
      })();
    {% endjs %}

    <nav class="btngroup">
      {% for name in lanes %}
        <a class="btn{{ name == lane ? ' active' : '' }}"
           href="{{ url('kunstmaan-migrator/mapping', { lane: name }) }}">
          {{- name -}}
          {%- if (open[name] ?? 0) > 0 %} <span class="badge">{{ open[name] }}</span>{% endif -%}
        </a>
      {% endfor %}
    </nav>

    {% if prefill %}
      <div class="readable" style="margin: 16px 0;">
        <blockquote class="note tip">
          <p>
            {{ "{n, plural, =1{1 part has no target yet} other{# parts have no target yet}} — the content model at {path} already says where most go. Prefill drafts each row from its spec; every draft stays open until you review it."|t('kunstmaan-migrator', { n: prefill.undecided, path: '<code>' ~ prefill.specsPath ~ '</code>' })|raw }}
          </p>
          <form method="post" accept-charset="UTF-8">
            {{ csrfInput() }}
            {{ actionInput('kunstmaan-migrator/migration/prefill') }}
            <button type="submit" class="btn">{{ "Prefill from the content model"|t('kunstmaan-migrator') }}</button>
          </form>
        </blockquote>
      </div>
    {% endif %}

    {# Sixty rows with no sense of how many are done is a long list; the same
       sixty with a count is eleven to go. #}
    {% if progress and progress.total %}
      <div class="kuma-progress">
        <div class="kuma-progress__bar">
          <span style="width: {{ progress.percent }}%"></span>
        </div>
        <p class="kuma-progress__text">
          {% if progress.open %}
            <strong>{{ "{n, plural, =1{1 still to decide} other{# still to decide}}"|t('kunstmaan-migrator', { n: progress.open }) }}</strong>
            <span class="light">
              — {{ "{d} mapped, {x} not migrating"|t('kunstmaan-migrator', { d: progress.decided, x: progress.dropped }) }}
            </span>
          {% else %}
            <span data-icon="check" class="success"></span>
            <strong>{{ "Every row decided."|t('kunstmaan-migrator') }}</strong>
            <span class="light">
              — {{ "{d} mapped, {x} not migrating"|t('kunstmaan-migrator', { d: progress.decided, x: progress.dropped }) }}
            </span>
          {% endif %}
        </p>
      </div>
    {% endif %}

    <div class="flex" style="margin-top: 14px;">
      {{ forms.text({ id: 'kuma-search', placeholder: "Filter by name"|t('kunstmaan-migrator') }) }}
      <nav class="btngroup" id="kuma-status">
        <button type="button" class="btn active" data-status="">{{ "All"|t('kunstmaan-migrator') }}</button>
        <button type="button" class="btn" data-status="open">{{ "Open"|t('kunstmaan-migrator') }}</button>
        <button type="button" class="btn" data-status="decided">{{ "Decided"|t('kunstmaan-migrator') }}</button>
      </nav>
    </div>

    {# Ordered by live volume rather than by name: that is where the content is,
       and an alphabetical list buries the ten rows that matter under sixty
       that do not. #}
    <table class="data fullwidth" style="margin-top: 14px;">
      <thead>
        <tr>
          <th>{{ "Legacy"|t('kunstmaan-migrator') }}</th>
          <th class="rightalign">{{ "Live"|t('kunstmaan-migrator') }}</th>
          <th>{{ "Becomes"|t('kunstmaan-migrator') }}</th>
          <th>{{ "Unplaced columns"|t('kunstmaan-migrator') }}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
          <tr data-name="{{ row.key }} {{ row.table }}" data-status="{{ row.status() }}">
            <th scope="row">
              {% if row.status() == 'decided' %}
                <span data-icon="check" class="success"></span>
              {% elseif row.status() == 'dropped' %}
                <span data-icon="remove" class="light"></span>
              {% else %}
                <span data-icon="alert"></span>
              {% endif %}
              {{ row.key }}
              {% if row.table %}<span class="light"><code>{{ row.table }}</code></span>{% endif %}
            </th>
            <td class="rightalign">{{ row.live|number_format }}</td>
            <td>
              {% if row.dropped %}
                <span class="light">{{ "not migrated"|t('kunstmaan-migrator') }} — {{ row.dropped }}</span>
              {% elseif row.target %}
                <code>{{ row.target }}</code>
              {% else %}
                <span class="error">{{ "no target yet"|t('kunstmaan-migrator') }}</span>
              {% endif %}
            </td>
            <td>
              {% if row.unreviewed is empty %}
                <span class="light">—</span>
              {% else %}
                <span class="error">{{ row.unreviewed|length }}</span>
                <span class="light">{{ row.unreviewed|slice(0, 4)|join(', ') }}{% if row.unreviewed|length > 4 %}…{% endif %}</span>
              {% endif %}
            </td>
            <td class="rightalign">
              <a class="btn small"
                 href="{{ url('kunstmaan-migrator/mapping-row', { lane: lane, key: row.key }) }}">{{ "Edit"|t('kunstmaan-migrator') }}</a>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="5" class="light">{{ "Nothing here."|t('kunstmaan-migrator') }}</td></tr>
        {% endfor %}
        <tr id="kuma-empty" style="display: none;"><td colspan="5" class="light">{{ "Nothing matches."|t('kunstmaan-migrator') }}</td></tr>
      </tbody>
    </table>

    {% js %}
      (function () {
        var search = document.getElementById('kuma-search');
        var buttons = [].slice.call(document.querySelectorAll('#kuma-status .btn'));
        var empty = document.getElementById('kuma-empty');
        if (!search) return;

        var params = new URLSearchParams(location.search);
        search.value = params.get('q') || '';
        var status = params.get('status') || '';
        if (status !== 'open' && status !== 'decided') status = '';

        var apply = function () {
          buttons.forEach(function (button) {
            button.classList.toggle('active', button.getAttribute('data-status') === status);
          });

          var needle = search.value.toLowerCase();
          var visible = 0;
          [].slice.call(document.querySelectorAll('tbody tr[data-name]')).forEach(function (row) {
            var rowStatus = row.getAttribute('data-status');
            var shown = row.getAttribute('data-name').toLowerCase().indexOf(needle) !== -1
              && (status === '' || (status === 'decided' ? rowStatus !== 'open' : rowStatus === 'open'));
            row.style.display = shown ? '' : 'none';
            if (shown) visible++;
          });
          if (empty) empty.style.display = visible === 0 ? '' : 'none';

          var url = new URLSearchParams(location.search);
          if (search.value) { url.set('q', search.value); } else { url.delete('q'); }
          if (status) { url.set('status', status); } else { url.delete('status'); }
          var query = url.toString();
          history.replaceState(null, '', location.pathname + (query ? '?' + query : ''));
        };

        search.addEventListener('input', apply);
        buttons.forEach(function (button) {
          button.addEventListener('click', function () {
            status = button.getAttribute('data-status');
            apply();
          });
        });

        apply();
      })();
    {% endjs %}
  {% endif %}
{% css %}
    .kuma-progress { margin: 14px 0 4px; }
    .kuma-progress__bar {
      height: 6px; border-radius: 3px; overflow: hidden;
      background: var(--gray-200, #cdd8e4);
    }
    .kuma-progress__bar span {
      display: block; height: 100%;
      background: var(--enabled-color, #27ab83);
      transition: width .2s ease;
    }
    .kuma-progress__text { margin: 6px 0 0; font-size: 13px; }
  {% endcss %}
{% endblock %}
