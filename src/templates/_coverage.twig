{% extends "_layouts/cp.twig" %}
{% set selectedSubnavItem = 'coverage' %}
{% import "_includes/forms.twig" as forms %}
{% do view.registerAssetBundle('lameco\\kunstmaanmigrator\\web\\MigratorAsset') %}

{% set title = "Coverage"|t('kunstmaan-migrator') %}

{% block content %}
  {% if targets is empty %}
    <div class="readable">
      <blockquote class="note">
        <p>{{ "Nothing to check yet. Decide the pages tab first."|t('kunstmaan-migrator') }}</p>
      </blockquote>
    </div>
  {% else %}
    <p class="light">
      {{ "For each target: every field, and what fills it. A field nothing fills stays empty after migration."|t('kunstmaan-migrator') }}
    </p>

    {% set kindLabels = { page: 'Pages'|t('kunstmaan-migrator'), entity: 'Entities'|t('kunstmaan-migrator'), block: 'Blocks'|t('kunstmaan-migrator') } %}

    {% if gaps is not empty %}
      <div class="readable" style="margin-bottom: 16px;">
        <blockquote class="note {{ gaps|filter(g => g.required > 0) is not empty ? 'warning' }}">
          <p>
            {{ "Not fully covered:"|t('kunstmaan-migrator') }}
            {% set summaryParts = [] %}
            {% for kindKey, label in kindLabels %}
              {% set kindGaps = gaps|filter(g => g.kind == kindKey) %}
              {% if kindGaps is not empty %}
                {% set summaryParts = summaryParts|merge([label ~ ' ' ~ kindGaps|length]) %}
              {% endif %}
            {% endfor %}
            {{ summaryParts|join(' · ') }}
            {% set requiredTotal = gaps|reduce((carry, g) => carry + g.required, 0) %}
            {% if requiredTotal > 0 %}
              — <strong>{{ "{count} required in total"|t('kunstmaan-migrator', { count: requiredTotal }) }}</strong>
            {% endif %}
          </p>
          <details>
            <summary>{{ "Show all"|t('kunstmaan-migrator') }}</summary>
            <p>
              {% for gap in gaps %}
                <a href="{{ url('kunstmaan-migrator/coverage', { kind: gap.kind, handle: gap.handle, gaps: 1 }) }}">{{ gap.handle }}</a>{% if gap.kind != 'page' %} <span class="light">({{ gap.kind }})</span>{% endif %}
                ({{ gap.unfed }}{% if gap.required > 0 %}, <strong>{{ "{count} required"|t('kunstmaan-migrator', { count: gap.required }) }}</strong>{% endif %}){{ not loop.last ? ' · ' }}
              {% endfor %}
            </p>
          </details>
        </blockquote>
      </div>
    {% else %}
      <p class="light">{{ "✓ Every field is covered."|t('kunstmaan-migrator') }}</p>
    {% endif %}

    {% set options = [] %}
    {% for kindKey, label in kindLabels %}
      {% set ofKind = targets|filter(t => t.kind == kindKey) %}
      {% if ofKind is not empty %}
        {% set options = options|merge([{ optgroup: label }])|merge(
          ofKind|map(t => { label: t.handle, value: t.kind ~ ':' ~ t.handle })
        ) %}
      {% endif %}
    {% endfor %}

    {{ forms.selectizeField({
      label: "Target"|t('kunstmaan-migrator'),
      instructions: "A page type, an entity, or a block."|t('kunstmaan-migrator'),
      id: 'kuma-coverage-type',
      name: 'target',
      value: kind ~ ':' ~ handle,
      options: options,
    }) }}

    {{ forms.checkboxField({
      label: "Only unfed fields"|t('kunstmaan-migrator'),
      id: 'kuma-only-unfed',
      name: 'onlyUnfed',
    }) }}
    <p class="light" id="kuma-unfed-count" style="margin-top: 4px;"></p>

    {% js %}
      (function () {
        var container = document.getElementById('kuma-coverage-table');
        var onlyUnfed = document.getElementById('kuma-only-unfed');

        var countLine = document.getElementById('kuma-unfed-count');

        function kumaApplyUnfed() {
          var on = onlyUnfed.checked;
          var rows = container.querySelectorAll('tr[data-fed]');
          var visible = 0;

          rows.forEach(function (row) {
            var hide = on && row.dataset.fed === '1';
            row.style.display = hide ? 'none' : '';
            if (!hide) { visible++; }
          });

          var covered = container.querySelector('#kuma-all-covered');
          if (covered) {
            covered.style.display = (on && visible === 0 && rows.length > 0) ? '' : 'none';
          }

          // The toggle must visibly answer, even when it hides nothing —
          // on a barely covered target the counts are the only feedback.
          if (countLine) {
            countLine.textContent = on
              ? '{{ "Showing {shown} of {total} fields."|t('kunstmaan-migrator', { shown: '###S', total: '###T' })|e('js') }}'
                  .replace('###S', String(visible)).replace('###T', String(rows.length))
              : '';
          }
        }

        onlyUnfed.checked = new URLSearchParams(location.search).get('gaps') === '1';

        onlyUnfed.addEventListener('change', function () {
          var params = new URLSearchParams(location.search);
          if (onlyUnfed.checked) { params.set('gaps', '1'); } else { params.delete('gaps'); }
          history.replaceState(null, '', location.pathname + (params.toString() ? '?' + params.toString() : ''));
          kumaApplyUnfed();
        });

        kumaApplyUnfed();

        $('#kuma-coverage-type').on('change', function () {
          var value = this.value;

          // Selectize fires a change with an empty value while the picker is
          // being cleared mid-choice; there is nothing to ask about yet.
          if (!value) { return; }

          var kind = value.slice(0, value.indexOf(':'));
          var handle = value.slice(value.indexOf(':') + 1);

          kumaSwap(container, 'kunstmaan-migrator/migration/coverage-table', { kind: kind, handle: handle }, {
            onDone: function () {
              // The address keeps meaning something: reloading or sharing the
              // URL lands on the target being looked at.
              var params = { kind: kind, handle: handle };
              if (onlyUnfed.checked) { params.gaps = 1; }
              history.replaceState(null, '', Craft.getCpUrl('kunstmaan-migrator/coverage', params));
              kumaApplyUnfed();
            },
          });
        });
      })();
    {% endjs %}

    <div id="kuma-coverage-table">
      {% include 'kunstmaan-migrator/_coverage-table' %}
    </div>
  {% endif %}
{% endblock %}
