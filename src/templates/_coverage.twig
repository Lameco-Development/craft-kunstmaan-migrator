{% extends "_layouts/cp.twig" %}
{% set selectedSubnavItem = 'coverage' %}
{% import "_includes/forms.twig" as forms %}
{% do view.registerAssetBundle('lameco\\kunstmaanmigrator\\web\\MigratorAsset') %}

{% set title = "Coverage"|t('kunstmaan-migrator') %}

{% block content %}
  {% if targets is empty %}
    <div class="readable">
      <blockquote class="note">
        <p>{{ "No page row targets an entry type yet. Decide the pages lane first — coverage is the view you verify those decisions with."|t('kunstmaan-migrator') }}</p>
      </blockquote>
    </div>
  {% else %}
    <p class="light">
      {{ "The mapping answers what each legacy thing becomes; this answers the inverse — for one entry type, every field and what feeds it. A field nothing feeds arrives empty on every migrated page."|t('kunstmaan-migrator') }}
    </p>

    {% if gaps is not empty %}
      <div class="readable" style="margin-bottom: 16px;">
        <blockquote class="note {{ gaps|filter(g => g.required > 0) is not empty ? 'warning' }}">
          <p>{{ "Targets with unfed fields:"|t('kunstmaan-migrator') }}
            {% for gap in gaps %}
              <a href="{{ url('kunstmaan-migrator/coverage', { kind: gap.kind, handle: gap.handle }) }}">{{ gap.handle }}</a>{% if gap.kind != 'page' %} <span class="light">({{ gap.kind }})</span>{% endif %}
              ({{ gap.unfed }}{% if gap.required > 0 %}, <strong>{{ "{count} required"|t('kunstmaan-migrator', { count: gap.required }) }}</strong>{% endif %}){{ not loop.last ? ' · ' }}
            {% endfor %}
          </p>
        </blockquote>
      </div>
    {% else %}
      <p class="light">{{ "✓ Every field of every mapped target is fed."|t('kunstmaan-migrator') }}</p>
    {% endif %}

    {% set kindLabels = { page: 'Pages'|t('kunstmaan-migrator'), entity: 'Entities'|t('kunstmaan-migrator'), block: 'Blocks'|t('kunstmaan-migrator') } %}
    {% set options = [] %}
    {% for kindKey, label in kindLabels %}
      {% set ofKind = targets|filter(t => t.kind == kindKey) %}
      {% if ofKind is not empty %}
        {% set options = options|merge([{ optgroup: label }])|merge(
          ofKind|map(t => { label: t.handle, value: t.kind ~ ':' ~ t.handle })
        ) %}
      {% endif %}
    {% endfor %}

    {{ forms.selectizeField({
      label: "Target"|t('kunstmaan-migrator'),
      instructions: "A page entry type, an entity entry type, or a block — everything migrated content lands in."|t('kunstmaan-migrator'),
      id: 'kuma-coverage-type',
      name: 'target',
      value: kind ~ ':' ~ handle,
      options: options,
    }) }}

    {% js %}
      (function () {
        var container = document.getElementById('kuma-coverage-table');

        $('#kuma-coverage-type').on('change', function () {
          var value = this.value;

          // Selectize fires a change with an empty value while the picker is
          // being cleared mid-choice; there is nothing to ask about yet.
          if (!value) { return; }

          var kind = value.slice(0, value.indexOf(':'));
          var handle = value.slice(value.indexOf(':') + 1);

          kumaSwap(container, 'kunstmaan-migrator/migration/coverage-table', { kind: kind, handle: handle }, {
            onDone: function () {
              // The address keeps meaning something: reloading or sharing the
              // URL lands on the target being looked at.
              history.replaceState(null, '', Craft.getCpUrl('kunstmaan-migrator/coverage', { kind: kind, handle: handle }));
            },
          });
        });
      })();
    {% endjs %}

    <div id="kuma-coverage-table">
      {% include 'kunstmaan-migrator/_coverage-table' %}
    </div>
  {% endif %}
{% endblock %}
