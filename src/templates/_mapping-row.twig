{% extends "_layouts/cp.twig" %}
{% set selectedSubnavItem = 'mapping' %}
{% import "_includes/forms.twig" as forms %}
{% do view.registerAssetBundle('Lameco\\Kunstmaanmigrator\\web\\MigratorAsset') %}

{% set title = row.key %}
{% set crumbs = [
  { label: "Mapping"|t('kunstmaan-migrator'), url: url('kunstmaan-migrator/mapping', { lane: lane }) },
  { label: lane, url: url('kunstmaan-migrator/mapping', { lane: lane }) },
] %}

{# Craft's own form, not one of ours nested inside it. The layout already wraps
   the page in a <form> when this is set, and a form inside a form is dropped by
   the browser — which is why the first version of this screen posted nothing at
   all when you pressed Save. #}
{% set fullPageForm = true %}

{% block content %}
  {{ actionInput('kunstmaan-migrator/migration/save-mapping-row') }}
  {{ redirectInput('kunstmaan-migrator/mapping?lane=' ~ lane) }}
  {{ hiddenInput('lane', lane) }}
  {{ hiddenInput('key', row.key) }}

  <p class="light">
      {# Each lane counts a different thing; calling entity rows "placements" is
         the small wrongness that makes an operator distrust the number. #}
      {% set liveNoun = {
        parts: "live placements"|t('kunstmaan-migrator'),
        pages: "live pages"|t('kunstmaan-migrator'),
        entities: "rows that become entries"|t('kunstmaan-migrator'),
        sidecars: "live pages decorated"|t('kunstmaan-migrator'),
      } %}
      {{ row.live|number_format }} {{ liveNoun[lane] ?? "live"|t('kunstmaan-migrator') }}
      {% if row.table %} · <code>{{ row.table }}</code>{% endif %}
  </p>

  {# Each lane targets a different kind of thing, and calling an entry type a
     block on the pages screen is the sort of small wrongness that makes an
     operator distrust the rest of the screen. #}
  {% set noun = lane == 'parts' ? "block"|t('kunstmaan-migrator') : "entry type"|t('kunstmaan-migrator') %}

  {% if lane == 'sidecars' %}
      {# A sidecar has no target of its own: it decorates whichever page carries
         its (ref_entity_name, ref_id) row, and its map addresses page fields
         directly. The field list below is the union across the page entry types;
         a field a type does not carry is dropped and counted at compile time. #}
      <p class="light">{{ "Writes onto the pages it decorates. Fields a page type does not have are skipped for that page."|t('kunstmaan-migrator') }}</p>
  {% elseif targetOptions is not empty %}
      {# Read from this Craft install, not typed from memory: a handle typed into
         YAML is checked when a migration runs, hours later. Selectize, because
         sixty handles is a list you search, not scroll. #}
      {{ forms.selectizeField({
        label: "Becomes"|t('kunstmaan-migrator'),
        instructions: "What this becomes in Craft. The field map below follows your choice; Save records it."|t('kunstmaan-migrator', { noun: noun }),
        name: 'target',
        value: row.target,
        options: [{ label: "— choose —"|t('kunstmaan-migrator'), value: '' }]|merge(targetOptions),
      }) }}
  {% else %}
      {{ forms.textField({
        label: "Becomes"|t('kunstmaan-migrator'),
        name: 'target',
        value: row.target,
      }) }}
  {% endif %}

  {% if lane != 'sidecars' %}
    {{ forms.lightswitchField({
        label: "Not migrating"|t('kunstmaan-migrator'),
        instructions: "This has no Craft equivalent. Everything below is ignored while this is on."|t('kunstmaan-migrator'),
        name: 'drop',
        on: row.dropped is not null,
        value: row.dropped ?? 'not migrating',
    }) }}
  {% endif %}

  <div class="field">
    <label>
      <input type="checkbox" id="kuma-attention">
      {{ "Only what needs attention"|t('kunstmaan-migrator') }}
    </label>
  </div>

  <div id="kuma-field-map">
    {% include 'kunstmaan-migrator/_mapping-row-fields' %}
  </div>

  {% set unused = row.columns() %}
  {% if unused is not empty %}
    <hr>

    {# Read-only: anything not mapped above simply does not migrate. The list
       stays for discovery — old data you might still want, with samples. #}
    <details class="readable" style="margin-top: 8px;">
      <summary class="light">{{ "{n, plural, =1{1 unused column — it does not migrate} other{# unused columns — they do not migrate}}"|t('kunstmaan-migrator', { n: unused|length }) }}</summary>
      <table class="data fullwidth" style="margin-top: 8px;">
        <tbody>
          {% for column, state in unused %}
            <tr>
              <th scope="row"><code>{{ column }}</code></th>
              <td class="light">{{ (samples[column] ?? [])|join(' · ') }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </details>
  {% endif %}


{# Two live behaviours share this block. Sample hints: `title` next to
   `page_title` is a coin flip until you see what each holds, and the hint
   follows the dropdown's current choice. Live field map: choosing a Becomes
   used to require a save before the fields appeared; now the choice redraws
   the map immediately — Save still records it. Rebinding is guarded per
   element because the field map is swapped wholesale. #}
{% js %}
  (function () {
    var samples = {{ samples|json_encode|raw }};

    var kumaBindSamples = function (root) {
      root.querySelectorAll('select[name^="map["][name$="][column]"]').forEach(function (sel) {
        if (sel.dataset.kumaSamples) { return; }
        sel.dataset.kumaSamples = '1';
        var hint = document.createElement('div');
        hint.className = 'light';
        sel.closest('td').appendChild(hint);
        var sync = function () {
          var values = samples[sel.value] || [];
          hint.textContent = values.length ? values.join(' · ') : '';
        };
        $(sel).on('change', sync);
        sync();
      });
    };
    kumaBindSamples(document);

    var becomes = document.querySelector('select[name="target"]');
    var container = document.getElementById('kuma-field-map');
    var attention = document.getElementById('kuma-attention');

    var kumaApplyAttention = function () {
      var on = attention && attention.checked;
      if (container) {
        container.querySelectorAll('tr[data-state]').forEach(function (tr) {
          tr.style.display = (on && tr.dataset.state !== 'empty') ? 'none' : '';
        });
      }
    };

    if (attention) {
      attention.checked = new URLSearchParams(location.search).get('attention') === '1';
      $(attention).on('change', function () {
        var params = new URLSearchParams(location.search);
        if (attention.checked) {
          params.set('attention', '1');
        } else {
          params.delete('attention');
        }
        var query = params.toString();
        history.replaceState(null, '', location.pathname + (query ? '?' + query : ''));
        kumaApplyAttention();
      });
      kumaApplyAttention();
    }

    if (becomes && container) {
      $(becomes).on('change', function () {
        kumaSwap(container, 'kunstmaan-migrator/migration/field-map', {
          lane: {{ lane|json_encode|raw }},
          key: {{ row.key|json_encode|raw }},
          target: becomes.value,
        }, {
          onDone: function () {
            kumaBindSamples(container);
            kumaApplyAttention();
          },
        });
      });
    }
  })();
{% endjs %}

{% endblock %}
