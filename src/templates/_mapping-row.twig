{% extends "_layouts/cp.twig" %}
{% set selectedSubnavItem = 'mapping' %}
{% import "_includes/forms.twig" as forms %}

{% set title = row.key %}
{% set crumbs = [{ label: "Mapping"|t('kunstmaan-migrator'), url: url('kunstmaan-migrator/mapping', { lane: lane }) }] %}

{# Craft's own form, not one of ours nested inside it. The layout already wraps
   the page in a <form> when this is set, and a form inside a form is dropped by
   the browser — which is why the first version of this screen posted nothing at
   all when you pressed Save. #}
{% set fullPageForm = true %}

{% block content %}
  {{ actionInput('kunstmaan-migrator/migration/save-mapping-row') }}
  {{ redirectInput('kunstmaan-migrator/mapping?lane=' ~ lane) }}
  {{ hiddenInput('lane', lane) }}
  {{ hiddenInput('key', row.key) }}

  <p class="light">
      {# Each lane counts a different thing; calling entity rows "placements" is
         the small wrongness that makes an operator distrust the number. #}
      {% set liveNoun = {
        parts: "live placements"|t('kunstmaan-migrator'),
        pages: "live pages"|t('kunstmaan-migrator'),
        entities: "rows that become entries"|t('kunstmaan-migrator'),
        sidecars: "live pages decorated"|t('kunstmaan-migrator'),
      } %}
      {{ row.live|number_format }} {{ liveNoun[lane] ?? "live"|t('kunstmaan-migrator') }}
      {% if row.table %} · <code>{{ row.table }}</code>{% endif %}
  </p>

  {# Each lane targets a different kind of thing, and calling an entry type a
     block on the pages screen is the sort of small wrongness that makes an
     operator distrust the rest of the screen. #}
  {% set noun = lane == 'parts' ? "block"|t('kunstmaan-migrator') : "entry type"|t('kunstmaan-migrator') %}

  {% if lane == 'sidecars' %}
      {# A sidecar has no target of its own: it decorates whichever page carries
         its (ref_entity_name, ref_id) row, and its map addresses page fields
         directly. The field list below is the union across the page entry types;
         a field a type does not carry is dropped and counted at compile time. #}
      <p class="light">{{ "Writes onto the page it decorates — no target to choose. Fields a page entry type does not carry are dropped for that page and counted."|t('kunstmaan-migrator') }}</p>
  {% elseif blocks is not empty %}
      {# Read from this Craft install, not typed from memory: a handle typed into
         YAML is checked when a migration runs, hours later. #}
      {{ forms.selectField({
        label: "Becomes"|t('kunstmaan-migrator'),
        instructions: "The Craft {noun} this legacy row becomes. Only what this install offers is listed; save to see its fields."|t('kunstmaan-migrator', { noun: noun }),
        name: 'target',
        value: row.target,
        options: [{ label: "— choose —"|t('kunstmaan-migrator'), value: '' }]|merge(
          blocks|map(b => { label: b, value: b })
        ),
      }) }}
  {% else %}
      {{ forms.textField({
        label: "Becomes"|t('kunstmaan-migrator'),
        name: 'target',
        value: row.target,
      }) }}
  {% endif %}

  {% if fields is not empty %}
      <hr>

      <h2>{{ "Field map"|t('kunstmaan-migrator') }}</h2>
      <p class="light">
        {% if columns is not empty %}
          {{ "The fields of the chosen target, and which column of the old table fills each. Both lists are real — the fields from this Craft install, the columns from the old database."|t('kunstmaan-migrator') }}
        {% else %}
          {{ "The fields of the chosen target. The old database is not reachable right now, so type the column names."|t('kunstmaan-migrator') }}
        {% endif %}
      </p>

      <table class="data fullwidth">
        <thead>
          <tr>
            <th>{{ "Craft field"|t('kunstmaan-migrator') }}</th>
            <th>{{ "Old column"|t('kunstmaan-migrator') }}</th>
            <th>{{ "Converted how"|t('kunstmaan-migrator') }}</th>
          </tr>
        </thead>
        <tbody>
          {% for field in fields %}
            {% set expression = expressions[field] %}
            <tr>
              <th scope="row"><code>{{ field }}</code></th>

              {% if expression.isAdvanced() %}
                {# `link(link_url, title, link_new_window)` composes several
                   columns into one field and `ref(Entity)` names an entity, not
                   a column. Neither fits two dropdowns, and a form that
                   pretended otherwise would quietly drop the arguments. #}
                <td colspan="2">
                  {{ forms.text({
                    name: 'map[' ~ field ~ '][advanced]',
                    value: expression.advanced,
                    class: 'code',
                  }) }}
                  <span class="light">{{ "Written by hand — leave as it is unless you know the grammar."|t('kunstmaan-migrator') }}</span>
                </td>
              {% else %}
                <td>
                  {% if columns is not empty %}
                    {{ forms.selectize({
                      name: 'map[' ~ field ~ '][column]',
                      value: expression.column,
                      options: [{ label: "— not filled —"|t('kunstmaan-migrator'), value: '' }]|merge(
                        columns|map(c => { label: c, value: c })
                      ),
                    }) }}
                  {% else %}
                    {{ forms.text({ name: 'map[' ~ field ~ '][column]', value: expression.column }) }}
                  {% endif %}
                </td>
                <td>
                  {{ forms.selectize({
                    name: 'map[' ~ field ~ '][transform]',
                    value: expression.transform,
                    options: [{ label: "As it is"|t('kunstmaan-migrator'), value: '' }]|merge(
                      transforms|keys|map(t => { label: transforms[t], value: t })
                    ),
                  }) }}
                </td>
              {% endif %}
            </tr>
          {% endfor %}
        </tbody>
      </table>

      {% set unknown = row.map|keys|filter(f => f not in fields) %}
      {% if unknown is not empty %}
        <blockquote class="note warning">
          <p>
            {{ "The mapping fills fields this target does not have:"|t('kunstmaan-migrator') }}
            <code>{{ unknown|join('</code>, <code>')|raw }}</code>.
            {{ "They are left untouched here; fix them in the file, or change the block."|t('kunstmaan-migrator') }}
          </p>
        </blockquote>
      {% endif %}
  {% endif %}

  <hr>

  <h2>{{ "Legacy columns"|t('kunstmaan-migrator') }}</h2>
  <p class="light">
      {{ "Columns with no field of their own. One left unplaced keeps this row open — that is deliberate, so a mapping cannot look finished while content still has nowhere to go. A column you fill a field from above does not belong here."|t('kunstmaan-migrator') }}
  </p>

  <table class="data fullwidth">
      <thead>
        <tr>
          <th>{{ "Column"|t('kunstmaan-migrator') }}</th>
          <th>{{ "Decision"|t('kunstmaan-migrator') }}</th>
          <th>{{ "Why not"|t('kunstmaan-migrator') }}</th>
        </tr>
      </thead>
      <tbody>
        {% for column, state in row.columns() %}
          <tr>
            <th scope="row"><code>{{ column }}</code></th>
            <td>
              {{ forms.select({
                name: 'columns[' ~ column ~ '][disposition]',
                value: state.ignored ? 'ignore' : 'unreviewed',
                options: [
                  { label: "Not looked at"|t('kunstmaan-migrator'), value: 'unreviewed' },
                  { label: "Deliberately not migrated"|t('kunstmaan-migrator'), value: 'ignore' },
                ],
              }) }}
            </td>
            <td>
              {{ forms.text({
                name: 'columns[' ~ column ~ '][reason]',
                value: state.reason,
                placeholder: state.ignored
                  ? "decided, but no reason recorded"|t('kunstmaan-migrator')
                  : "why this is not migrated"|t('kunstmaan-migrator'),
              }) }}
            </td>
          </tr>
        {% else %}
          <tr><td colspan="3" class="light">{{ "Every column of this table has a home."|t('kunstmaan-migrator') }}</td></tr>
        {% endfor %}
      </tbody>
  </table>

  <hr>

  {{ forms.textField({
      label: "Or drop it entirely"|t('kunstmaan-migrator'),
      instructions: "A reason here means this legacy row has no Craft equivalent and is not migrating. The reason is the point: a run reports a deliberate omission differently from one nobody decided about."|t('kunstmaan-migrator'),
      name: 'drop',
      value: row.dropped,
  }) }}

{% endblock %}
