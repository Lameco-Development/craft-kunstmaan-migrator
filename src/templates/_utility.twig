{% import "_includes/forms.twig" as forms %}

{% if isProduction %}
  <div class="readable">
    <blockquote class="note warning">
      <p>{{ "This is a production environment. The migrator refuses to run here."|t('app') }}</p>
    </blockquote>
  </div>
{% endif %}

{% if error %}
  <div class="readable">
    <blockquote class="note">
      <p>{{ error }}</p>
    </blockquote>
  </div>
{% else %}

  <p class="light"><code>{{ mappingPath }}</code></p>

  <h2>{{ "Preflight"|t('app') }}</h2>

  <table class="data fullwidth">
    <thead>
      <tr>
        <th>{{ "Environment"|t('app') }}</th>
        <th>{{ "Database"|t('app') }}</th>
        <th>{{ "Nodes"|t('app') }}</th>
        <th>{{ "Findings"|t('app') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for check in checks %}
        <tr>
          <th scope="row">
            {% if check.isBlocked %}
              <span data-icon="alert" class="error"></span>
            {% elseif check.isReady %}
              <span data-icon="check" class="success"></span>
            {% else %}
              <span data-icon="alert"></span>
            {% endif %}
            {{ check.name }}
          </th>
          <td><code>{{ check.database }}</code></td>
          <td>{{ check.nodeCount is null ? '—' : check.nodeCount|number_format }}</td>
          <td>
            {% for problem in check.problems %}
              <div class="{{ check.isBlocked ? 'error' : '' }}">{{ problem }}</div>
            {% else %}
              <span class="light">{{ "Ready"|t('app') }}</span>
            {% endfor %}
            {% if check.localesNotMigrated %}
              <div class="light">
                {{ "Not migrated by design:"|t('app') }} {{ check.localesNotMigrated|join(', ') }}
              </div>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

  <hr>

  <h2>{{ "Run"|t('app') }}</h2>

  {{ forms.selectField({
    label: "Environment"|t('app'),
    id: 'kuma-environment',
    name: 'environment',
    options: [{ label: "Every environment"|t('app'), value: '' }]|merge(
      checks|map(c => { label: c.name, value: c.name })
    ),
  }) }}

  {{ forms.lightswitchField({
    label: "Dry run"|t('app'),
    instructions: "Compile and validate without writing anything to Craft."|t('app'),
    id: 'kuma-dry-run',
    name: 'dryRun',
  }) }}

  {{ forms.lightswitchField({
    label: "Re-save existing entries"|t('app'),
    instructions: "Off by default so an interrupted run resumes cheaply. Turn it on after the payload changed."|t('app'),
    id: 'kuma-force',
    name: 'force',
  }) }}

  <div class="field">
    <div class="input">
      <button type="button" class="btn submit" id="kuma-queue">{{ "Queue migration"|t('app') }}</button>
      <span id="kuma-queue-result" class="light" style="margin-inline-start: 8px;"></span>
    </div>
    <div class="instructions">
      <p>{{ "The run happens on Craft's queue. Keep this tab open, or run craft queue/listen."|t('app') }}</p>
    </div>
  </div>

  {% js %}
    document.getElementById('kuma-queue').addEventListener('click', function () {
      var button = this;
      var result = document.getElementById('kuma-queue-result');
      button.disabled = true;
      result.className = 'light';
      result.textContent = '{{ "Queueing…"|t('app')|e('js') }}';

      Craft.sendActionRequest('POST', 'kunstmaan-migrator/migration/queue', {
        data: {
          environment: document.getElementById('kuma-environment').value,
          dryRun: document.getElementById('kuma-dry-run').checked ? 1 : 0,
          force: document.getElementById('kuma-force').checked ? 1 : 0
        }
      })
        .then(function (response) {
          result.textContent = response.data.message;
          result.className = response.data.ok ? 'success' : 'error';
          if (response.data.ok) { Craft.cp.runQueue(); }
        })
        .catch(function (error) {
          result.textContent = (error.response && error.response.data && error.response.data.message)
            || '{{ "Could not reach Craft."|t('app')|e('js') }}';
          result.className = 'error';
        })
        .finally(function () {
          button.disabled = false;
        });
    });
  {% endjs %}

{% endif %}
