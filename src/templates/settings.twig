{% import "_includes/forms.twig" as forms %}

{# The migrator only ever runs locally, against a legacy database on the same
   machine. Craft writes plugin settings into project config, which is committed
   and deployed — so the connection fields take the NAME of an environment
   variable, not its value, and the password field refuses anything else. #}

<h2>{{ "Legacy database"|t('app') }}</h2>

<p class="light">
  {{ "These fields take an environment variable name, so the values stay in your .env and out of project config."|t('app') }}
</p>

{{ forms.autosuggestField({
  label: "Server"|t('app'),
  id: 'legacyDbServer',
  name: 'legacyDbServer',
  value: settings.legacyDbServer,
  suggestEnvVars: true,
  errors: settings.getErrors('legacyDbServer'),
}) }}

{{ forms.textField({
  label: "Port"|t('app'),
  id: 'legacyDbPort',
  name: 'legacyDbPort',
  type: 'number',
  size: 6,
  value: settings.legacyDbPort,
  errors: settings.getErrors('legacyDbPort'),
}) }}

{{ forms.autosuggestField({
  label: "Database"|t('app'),
  id: 'legacyDbDatabase',
  name: 'legacyDbDatabase',
  value: settings.legacyDbDatabase,
  suggestEnvVars: true,
  errors: settings.getErrors('legacyDbDatabase'),
}) }}

{{ forms.autosuggestField({
  label: "User"|t('app'),
  id: 'legacyDbUser',
  name: 'legacyDbUser',
  value: settings.legacyDbUser,
  suggestEnvVars: true,
  errors: settings.getErrors('legacyDbUser'),
}) }}

{{ forms.autosuggestField({
  label: "Password"|t('app'),
  instructions: "Must be an environment variable — a value typed here would be committed to project config."|t('app'),
  id: 'legacyDbPassword',
  name: 'legacyDbPassword',
  value: settings.legacyDbPassword,
  suggestEnvVars: true,
  errors: settings.getErrors('legacyDbPassword'),
}) }}

<div class="field">
  <div class="input">
    <button type="button" class="btn" id="kuma-test-connection">{{ "Test connection"|t('app') }}</button>
    <span id="kuma-test-result" class="light" style="margin-inline-start: 8px;"></span>
  </div>
  <div class="instructions">
    <p>{{ "Save first — the test uses the saved settings."|t('app') }}</p>
  </div>
</div>

<hr>

<h2>{{ "Adapters"|t('app') }}</h2>

<p class="light">
  {{ "Each adapter writes into a different plugin. Turning one off skips that pass; a plugin that is not installed skips it too, and the run says which."|t('app') }}
</p>

<table class="data fullwidth">
  <thead>
    <tr>
      <th>{{ "Adapter"|t('app') }}</th>
      <th>{{ "Requires"|t('app') }}</th>
      <th>{{ "Detected"|t('app') }}</th>
      <th>{{ "Enabled"|t('app') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for adapter in adapters %}
      <tr>
        <th scope="row">{{ adapter.label }}</th>
        <td>
          {% if adapter.pluginHandle %}
            <code>{{ adapter.pluginHandle }}</code>
          {% else %}
            <span class="light">{{ "built in"|t('app') }}</span>
          {% endif %}
        </td>
        <td>
          {% if adapter.pluginHandle is null %}
            <span class="light">—</span>
          {% elseif detected[adapter.handle] %}
            <span data-icon="check"></span> {{ detected[adapter.handle] }}
          {% else %}
            <span class="error">{{ "not installed"|t('app') }}</span>
          {% endif %}
        </td>
        <td>
          {{ forms.lightswitch({
            id: adapter.settingsFlag,
            name: adapter.settingsFlag,
            on: attribute(settings, adapter.settingsFlag),
          }) }}
        </td>
      </tr>
    {% endfor %}
  </tbody>
</table>

<hr>

<h2>{{ "Legacy table names"|t('app') }}</h2>

<p class="light">
  {{ "Defaults match a stock Kunstmaan schema. Override only where this project renamed a table."|t('app') }}
</p>

{% for field, label in {
  nodesTableName: "Nodes"|t('app'),
  seoTableName: "SEO"|t('app'),
  redirectsTableName: "Redirects"|t('app'),
  menuTableName: "Menu"|t('app'),
  menuItemTableName: "Menu items"|t('app'),
  translationTableName: "Translations"|t('app'),
} %}
  {{ forms.textField({
    label: label,
    id: field,
    name: field,
    value: attribute(settings, field),
    errors: settings.getErrors(field),
  }) }}
{% endfor %}

{% js %}
  document.getElementById('kuma-test-connection').addEventListener('click', function () {
    var button = this;
    var result = document.getElementById('kuma-test-result');
    button.disabled = true;
    result.textContent = '{{ "Connecting…"|t('app')|e('js') }}';
    result.className = 'light';

    Craft.sendActionRequest('POST', 'kunstmaan-migrator/settings/test-connection')
      .then(function (response) {
        result.textContent = response.data.message;
        result.className = response.data.ok ? 'success' : 'error';
      })
      .catch(function (error) {
        result.textContent = (error.response && error.response.data && error.response.data.message)
          || '{{ "Could not reach Craft."|t('app')|e('js') }}';
        result.className = 'error';
      })
      .finally(function () {
        button.disabled = false;
      });
  });
{% endjs %}
