{% import "_includes/forms.twig" as forms %}

{# The migrator only ever runs locally, against a legacy database on the same
   machine. Craft writes plugin settings into project config, which is committed
   and deployed — so the connection fields take the NAME of an environment
   variable, not its value, and the password field refuses anything else. #}

<h2>{{ "Legacy database"|t('kunstmaan-migrator') }}</h2>

<p class="light">
  {{ "These fields take an environment variable name, so the values stay in your .env and out of project config. Which database each environment reads comes from the mapping, not from here."|t('kunstmaan-migrator') }}
</p>

{{ forms.autosuggestField({
  label: "Server"|t('kunstmaan-migrator'),
  id: 'legacyDbServer',
  name: 'legacyDbServer',
  value: settings.legacyDbServer,
  suggestEnvVars: true,
  errors: settings.getErrors('legacyDbServer'),
}) }}

{{ forms.textField({
  label: "Port"|t('kunstmaan-migrator'),
  id: 'legacyDbPort',
  name: 'legacyDbPort',
  type: 'number',
  size: 6,
  value: settings.legacyDbPort,
  errors: settings.getErrors('legacyDbPort'),
}) }}

{{ forms.autosuggestField({
  label: "User"|t('kunstmaan-migrator'),
  id: 'legacyDbUser',
  name: 'legacyDbUser',
  value: settings.legacyDbUser,
  suggestEnvVars: true,
  errors: settings.getErrors('legacyDbUser'),
}) }}

{{ forms.autosuggestField({
  label: "Password"|t('kunstmaan-migrator'),
  instructions: "Must be an environment variable — a value typed here would be committed to project config."|t('kunstmaan-migrator'),
  id: 'legacyDbPassword',
  name: 'legacyDbPassword',
  value: settings.legacyDbPassword,
  suggestEnvVars: true,
  errors: settings.getErrors('legacyDbPassword'),
}) }}

<hr>

<h2>{{ "Assets"|t('kunstmaan-migrator') }}</h2>

<p class="light">
  {{ "Where migrated files land. These are read by the entry pass, not by an adapter, so they apply to every run."|t('kunstmaan-migrator') }}
</p>

{# Rendered from Settings::coreSettings(), for the same reason the adapter
   settings below are rendered from what each adapter declares: a list typed
   into a template is a list that gets forgotten. `targetVolume` spent this
   plugin's life invisible while defaulting to a volume half the projects
   using it do not have. #}
{% for setting in coreSettings %}
  {% set pinned = setting.handle in overridden %}
  {% set warning = pinned
    ? "Set in config/kunstmaan-migrator.php, which wins over anything saved here."|t('kunstmaan-migrator')
    : null %}

  {% if setting.type == 'boolean' %}
    {{ forms.lightswitchField({
      label: setting.label,
      instructions: setting.instructions,
      name: setting.handle,
      on: settings.core(setting),
      disabled: pinned,
      warning: warning,
    }) }}
  {% else %}
    {{ forms.textField({
      label: setting.label,
      instructions: setting.instructions,
      name: setting.handle,
      value: settings.core(setting),
      placeholder: setting.default,
      disabled: pinned,
      warning: warning,
    }) }}
  {% endif %}
{% endfor %}

<hr>

<h2>{{ "Adapters"|t('kunstmaan-migrator') }}</h2>

<p class="light">
  {{ "Each adapter writes into a different plugin. Turning one off skips that pass; a plugin that is not installed skips it too, and the run says which."|t('kunstmaan-migrator') }}
</p>

<table class="data fullwidth">
  <thead>
    <tr>
      <th>{{ "Adapter"|t('kunstmaan-migrator') }}</th>
      <th>{{ "Requires"|t('kunstmaan-migrator') }}</th>
      <th>{{ "Detected"|t('kunstmaan-migrator') }}</th>
      <th>{{ "Enabled"|t('kunstmaan-migrator') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for adapter in adapters %}
      <tr>
        <th scope="row">{{ adapter.label }}</th>
        <td>
          {% if adapter.pluginHandle %}
            <code>{{ adapter.pluginHandle }}</code>
          {% else %}
            <span class="light">{{ "built in"|t('kunstmaan-migrator') }}</span>
          {% endif %}
        </td>
        <td>
          {% if adapter.pluginHandle is null %}
            <span class="light">—</span>
          {% elseif detected[adapter.handle] %}
            <span data-icon="check"></span> {{ detected[adapter.handle] }}
          {% else %}
            <span class="error">{{ "not installed"|t('kunstmaan-migrator') }}</span>
          {% endif %}
        </td>
        <td>
          {{ forms.lightswitch({
            id: adapter.handle ~ '-enabled',
            name: settings.adapterEnabledInputName(adapter),
            on: settings.isAdapterEnabled(adapter),
          }) }}
        </td>
      </tr>
    {% endfor %}
  </tbody>
</table>

{# Rendered from what each adapter declares, not from a list kept here. An
   adapter's preferences used to be literal properties on the Settings model
   and fields typed into this template, which meant a project's own adapter
   could be neither configured nor shown — and meant the single most
   project-specific value in the plugin, the nav the navigation pass writes
   into, was editable only in a PHP config file. #}
{% for adapter in adapters|filter(adapter => adapter.settings is not empty) %}
  <h3>{{ adapter.label }}</h3>

  {% set values = settings.forAdapter(adapter) %}

  {% for setting in adapter.settings %}
    {% set name = 'adapters[' ~ adapter.handle ~ '][' ~ setting.handle ~ ']' %}


    {% if setting.type == 'boolean' %}
      {{ forms.lightswitchField({
        label: setting.label,
        instructions: setting.instructions,
        name: name,
        on: values[setting.handle],
      }) }}
    {% else %}
      {{ forms.textField({
        label: setting.label,
        instructions: setting.instructions,
        name: name,
        value: setting.type == 'list'
          ? (values[setting.handle] ?? [])|join(', ')
          : values[setting.handle],
        placeholder: setting.type == 'list' ? (setting.default ?? [])|join(', ') : setting.default,
      }) }}
    {% endif %}
  {% endfor %}
{% endfor %}

<hr>

<h2>{{ "Environments"|t('kunstmaan-migrator') }}</h2>

{{ forms.autosuggestField({
  disabled: 'mappingPath' in overridden,
  warning: 'mappingPath' in overridden
    ? "Set in config/kunstmaan-migrator.php, which wins over anything saved here."|t('kunstmaan-migrator')
    : null,
  label: "Mapping file"|t('kunstmaan-migrator'),
  instructions: "The mapping owns which databases exist, where each one's uploads live, and which legacy locale writes to which Craft site. It is version-controlled next to the field mappings it travels with."|t('kunstmaan-migrator'),
  id: 'mappingPath',
  name: 'mappingPath',
  value: settings.mappingPath,
  suggestEnvVars: true,
  errors: settings.getErrors('mappingPath'),
}) }}

{% if environments is empty %}
  <p class="light">
    {{ "Point at a mapping file and save to see the environments it declares."|t('kunstmaan-migrator') }}
  </p>
{% else %}
  <p class="light">
    {{ "Read-only — edit the mapping file to change any of this."|t('kunstmaan-migrator') }}
  </p>

  <table class="data fullwidth">
    <thead>
      <tr>
        <th>{{ "Environment"|t('kunstmaan-migrator') }}</th>
        <th>{{ "Database"|t('kunstmaan-migrator') }}</th>
        <th>{{ "Upload directories"|t('kunstmaan-migrator') }}</th>
        <th>{{ "Locale → site"|t('kunstmaan-migrator') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for name, env in environments %}
        <tr>
          <th scope="row">{{ name }}</th>
          <td><code>{{ env.database ?? '—' }}</code></td>
          <td>
            {% for root in env.mediaRoot %}
              <div><code>{{ root }}</code>{% if not loop.first %} <span class="light">{{ "(fallback)"|t('kunstmaan-migrator') }}</span>{% endif %}</div>
            {% else %}
              <span class="light">—</span>
            {% endfor %}
          </td>
          <td>
            {% for locale, handle in env.locales %}
              <div>
                <code>{{ locale }}</code> →
                {% if handle %}<code>{{ handle }}</code>{% else %}<span class="light">{{ "not migrated"|t('kunstmaan-migrator') }}</span>{% endif %}
              </div>
            {% else %}
              <span class="light">—</span>
            {% endfor %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endif %}
