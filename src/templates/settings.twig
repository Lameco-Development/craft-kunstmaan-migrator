{% import "_includes/forms.twig" as forms %}

{# What lives here, and what deliberately does not.

   This screen holds the settings that vary with the legacy corpus — which
   adapter passes run, and the per-adapter knobs (source-table overrides,
   translation domains, the nav handle) that differ from one Kunstmaan install
   to the next. Everything machine- or deploy-level — the legacy connection,
   the mapping path, where assets land — lives in config/kunstmaan-migrator.php
   and .env: those values are either machine-local (an absolute path, a DB
   password variable) or one-time operator decisions, and a form that writes
   them into committed project config invited both kinds to travel to
   production. The environments themselves are the mapping's to declare; the
   Mapping screen and the wizard show them where they are edited. #}

<h2>{{ "Adapters"|t('kunstmaan-migrator') }}</h2>

<p class="light">
  {{ "Each pass writes into a different plugin. Turn one off to skip it; missing plugins are skipped automatically."|t('kunstmaan-migrator') }}
</p>

<table class="data fullwidth">
  <thead>
    <tr>
      <th>{{ "Adapter"|t('kunstmaan-migrator') }}</th>
      <th>{{ "Requires"|t('kunstmaan-migrator') }}</th>
      <th>{{ "Detected"|t('kunstmaan-migrator') }}</th>
      <th>{{ "Enabled"|t('kunstmaan-migrator') }}</th>
    </tr>
  </thead>
  <tbody>
    {% for adapter in adapters %}
      <tr>
        <th scope="row">{{ adapter.label }}</th>
        <td>
          {% if adapter.pluginHandle %}
            <code>{{ adapter.pluginHandle }}</code>
          {% else %}
            <span class="light">{{ "built in"|t('kunstmaan-migrator') }}</span>
          {% endif %}
        </td>
        <td>
          {% if adapter.pluginHandle is null %}
            <span class="light">—</span>
          {% elseif detected[adapter.handle] %}
            <span data-icon="check"></span> {{ detected[adapter.handle] }}
          {% else %}
            <span class="error">{{ "not installed"|t('kunstmaan-migrator') }}</span>
          {% endif %}
        </td>
        <td>
          {{ forms.lightswitch({
            id: adapter.handle ~ '-enabled',
            name: settings.adapterEnabledInputName(adapter),
            on: settings.isAdapterEnabled(adapter),
          }) }}
        </td>
      </tr>
    {% endfor %}
  </tbody>
</table>

{# Rendered from what each adapter declares, not from a list kept here. An
   adapter's preferences used to be literal properties on the Settings model
   and fields typed into this template, which meant a project's own adapter
   could be neither configured nor shown. #}
{% for adapter in adapters|filter(adapter => adapter.settings is not empty) %}
  <h3>{{ adapter.label }}</h3>

  {% set values = settings.forAdapter(adapter) %}

  {% for setting in adapter.settings %}
    {% set name = 'adapters[' ~ adapter.handle ~ '][' ~ setting.handle ~ ']' %}


    {% if setting.type == 'boolean' %}
      {{ forms.lightswitchField({
        label: setting.label,
        instructions: setting.instructions,
        name: name,
        on: values[setting.handle],
      }) }}
    {% else %}
      {{ forms.textField({
        label: setting.label,
        instructions: setting.instructions,
        name: name,
        value: setting.type == 'list'
          ? (values[setting.handle] ?? [])|join(', ')
          : values[setting.handle],
        placeholder: setting.type == 'list' ? (setting.default ?? [])|join(', ') : setting.default,
      }) }}
    {% endif %}
  {% endfor %}
{% endfor %}

<hr>

<h2>{{ "Configuration"|t('kunstmaan-migrator') }}</h2>

<p class="light">
  {{ "The connection, the mapping path and asset placement are set in config/kunstmaan-migrator.php and .env — machine-level values a control panel form would commit to project config. This is what is in force right now:"|t('kunstmaan-migrator') }}
</p>

<table class="data fullwidth">
  <tbody>
    {% for row in effective %}
      <tr>
        <th scope="row">{{ row.label|t('kunstmaan-migrator') }}</th>
        <td>{% if row.value is null or row.value == '' %}<span class="light">—</span>{% else %}<code>{{ row.value }}</code>{% endif %}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>
