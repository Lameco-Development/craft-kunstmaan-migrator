{% extends "kunstmaan-migrator/_setup/_wizard" %}
{% import "_includes/forms.twig" as forms %}

{% block step %}
  {{ actionInput('kunstmaan-migrator/setup/choose-sites') }}
  <input type="hidden" name="envs" id="envs">

  {% if error %}
    <blockquote class="note warning">
      <p>{{ error }}</p>
      <p><a href="{{ url('kunstmaan-migrator/setup') }}">{{ "Check the connection"|t('kunstmaan-migrator') }}</a></p>
    </blockquote>
  {% else %}
    <div class="readable">
      <p>
        {% if narrowed %}
          {{ "The database the earlier steps named, and its sibling databases — a multi-country site often has one per country. All are ticked; untick anything that should stay behind."|t('kunstmaan-migrator') }}
        {% else %}
          {{ "These are the Kunstmaan sites on that server. One site is usually one database, and a multi-language site often has one per country. Anything the earlier steps named is already ticked."|t('kunstmaan-migrator') }}
        {% endif %}
      </p>
    </div>

    {% if not narrowed %}
      {{ forms.text({ id: 'kuma-filter', placeholder: "Search"|t('kunstmaan-migrator'), class: 'fullwidth' }) }}
    {% endif %}

    <div class="tablepane" style="margin-top: 10px;">
    <table class="data fullwidth">
      <thead>
        <tr>
          <th style="width: 40px;"></th>
          <th>{{ "Site"|t('kunstmaan-migrator') }}</th>
          <th class="rightalign">{{ "Pages"|t('kunstmaan-migrator') }}</th>
          <th>{{ "Short name"|t('kunstmaan-migrator') }}</th>
        </tr>
      </thead>
      <tbody>
        {% for candidate in databases %}
          <tr data-name="{{ candidate.database }}">
            <td>
              <input type="checkbox" class="checkbox kuma-pick" id="pick-{{ loop.index }}" data-database="{{ candidate.database }}"{% if candidate.preselected ?? false %} checked{% endif %}>
              <label for="pick-{{ loop.index }}"></label>
            </td>
            <th scope="row"><code>{{ candidate.database }}</code></th>
            <td class="rightalign">{{ candidate.nodes|number_format }}</td>
            <td>
              <input type="text" class="text kuma-label" value="{{ candidate.label }}" size="10"
                     aria-label="{{ 'Short name for {db}'|t('kunstmaan-migrator', { db: candidate.database }) }}">
            </td>
          </tr>
        {% else %}
          <tr><td colspan="4"><p class="zilch small">{{ "No Kunstmaan sites found on that server."|t('kunstmaan-migrator') }}</p></td></tr>
        {% endfor %}
      </tbody>
    </table>
    </div>

    <p class="light" id="kuma-count" style="margin-top: 10px;"></p>

    {% if narrowed %}
      <p>
        <a class="go" href="{{ url('kunstmaan-migrator/setup/sites', { all: 1 }) }}">
          {{ "Missing one? Show all {n} Kunstmaan sites on this server."|t('kunstmaan-migrator', { n: hiddenCount + databases|length }) }}
        </a>
      </p>
    {% endif %}
  {% endif %}

  {% js %}
    var rows = function () { return [].slice.call(document.querySelectorAll('.kuma-pick')); };

    // The short name is what a run reports and what every migrated row is keyed
    // by, so it has to be there before Next means anything.
    var refresh = function () {
      var picked = rows().filter(function (b) { return b.checked; });
      var pairs = picked.map(function (b) {
        var label = b.closest('tr').querySelector('.kuma-label').value.trim();
        return label + ':' + b.getAttribute('data-database');
      });

      document.getElementById('envs').value = pairs.join(',');

      var named = picked.every(function (b) { return b.closest('tr').querySelector('.kuma-label').value.trim() !== ''; });
      [].slice.call(document.querySelectorAll('#main-form button[type=submit]')).forEach(function (save) {
        save.disabled = picked.length === 0 || !named;
      });

      document.getElementById('kuma-count').textContent = picked.length === 0
        ? '{{ "Nothing selected yet."|t('kunstmaan-migrator')|e('js') }}'
        // Split so the source never contains `{` followed by `#`, which Twig
        // reads as the start of a comment.
        : Craft.t('kunstmaan-migrator', '{n, plural, =1{1 site selected} other{' + '# sites selected}}', { n: picked.length });
    };

    document.addEventListener('change', function (e) {
      if (e.target.classList.contains('kuma-pick')) { refresh(); }
    });
    document.addEventListener('input', function (e) {
      if (e.target.classList.contains('kuma-label')) { refresh(); }
    });

    var filter = document.getElementById('kuma-filter');
    if (filter) filter.addEventListener('input', function () {
      var needle = this.value.toLowerCase();
      document.querySelectorAll('tbody tr[data-name]').forEach(function (row) {
        row.style.display = row.getAttribute('data-name').toLowerCase().indexOf(needle) === -1 ? 'none' : '';
      });
    });

    refresh();
  {% endjs %}
{% endblock %}
