{% extends "kunstmaan-migrator/_setup/_wizard" %}
{% import "_includes/forms.twig" as forms %}
{% set nextLabel = "Create the mapping"|t('kunstmaan-migrator') %}

{% block step %}
  {{ actionInput('kunstmaan-migrator/setup/write') }}
  {{ hiddenInput('envs', envs) }}
  {{ hiddenInput('choices', choices) }}

  {# A review screen reviews. Every fact below is stated, not asked — anything
     that still needs deciding belongs on the step that asks it. #}

  <div class="readable">
    <p>
      {{ "{pages, number} pages across the languages below will migrate{skipped, plural, =0{.} other{; {skipped, number} pages stay behind.}}"|t('kunstmaan-migrator', { pages: totalPages, skipped: totalSkipped }) }}
    </p>
  </div>

  <div class="tablepane">
  <table class="data fullwidth">
    <thead>
      <tr>
        <th>{{ "Site"|t('kunstmaan-migrator') }}</th>
        <th>{{ "Coming across"|t('kunstmaan-migrator') }}</th>
        <th>{{ "Staying behind"|t('kunstmaan-migrator') }}</th>
      </tr>
    </thead>
    <tbody>
      {% for row in summary %}
        <tr>
          <th scope="row">{{ row.label }} <span class="light"><code>{{ row.database }}</code></span></th>
          <td>
            {% for locale, choice in row.migrating %}
              <div>
                <code>{{ locale }}</code> → <code>{{ choice.site }}</code>
                <span class="light">· {{ "{n, plural, =1{1 page} other{# pages}}"|t('kunstmaan-migrator', { n: choice.pages }) }}</span>
              </div>
            {% else %}
              <span class="error">{{ "Nothing — this site would migrate no pages."|t('kunstmaan-migrator') }}</span>
            {% endfor %}
          </td>
          <td>
            {% for locale, pages in row.skipping %}
              <div class="light"><code>{{ locale }}</code> · {{ "{n, plural, =1{1 page} other{# pages}}"|t('kunstmaan-migrator', { n: pages }) }}</div>
            {% else %}
              <span class="light">—</span>
            {% endfor %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>

  <hr>

  <h2>{{ "What gets created"|t('kunstmaan-migrator') }}</h2>

  <ul class="bullets">
    <li>
      {{ "{path} — the mapping: the list of decisions the migration follows. Creating it migrates nothing, and nothing is ever written to the old site."|t('kunstmaan-migrator', { path: '<code>' ~ mappingPath ~ '</code>' })|raw }}
    </li>
    {% if sourcePath %}
      <li>
        {{ "An introspection artifact, read from the old site's code at {path} — it gives the mapping exact table names and relations."|t('kunstmaan-migrator', { path: '<code>' ~ sourcePath ~ '</code>' })|raw }}
      </li>
    {% else %}
      <li class="light">
        {{ "No old-site code was found on this machine, so table names are left as TODOs in the mapping — fill them in while deciding the rows."|t('kunstmaan-migrator') }}
      </li>
    {% endif %}
    <li>
      {% if mediaRoot %}
        {{ "Files will be read from {path} — the Kunstmaan convention, taken from the detected checkout. The plugin settings can override it."|t('kunstmaan-migrator', { path: '<code>' ~ mediaRoot ~ '</code>' })|raw }}
      {% else %}
        {{ "No uploads folder was detected — set one in the plugin settings, or add mediaRoot lines to the mapping afterwards."|t('kunstmaan-migrator') }}
      {% endif %}
    </li>
  </ul>
  </div>

  {% if existingMapping %}
    {# Craft only styles note blockquotes inside a .readable wrapper. #}
    <div class="readable" style="margin-bottom: 16px;">
      <blockquote class="note warning">
        <p>
          {{ "A mapping already exists at {path}. Creating a new one moves it aside as a timestamped copy — nothing is deleted, but the migration follows the new file from then on."|t('kunstmaan-migrator', { path: '<code>' ~ existingMapping ~ '</code>' })|raw }}
        </p>
        {{ forms.checkboxField({
          label: "Replace it — keep the current mapping as a timestamped copy"|t('kunstmaan-migrator'),
          id: 'kuma-replace',
          name: 'replace',
          value: 1,
        }) }}
      </blockquote>
    </div>

    {% js %}
      var box = document.getElementById('kuma-replace');
      var saves = [].slice.call(document.querySelectorAll('#main-form button[type=submit]'));
      var sync = function () { saves.forEach(function (b) { b.disabled = !box.checked; }); };
      box.addEventListener('change', sync);
      sync();
    {% endjs %}
  {% endif %}

  <p class="light">
    {{ "Next, you decide what each piece of old content becomes — on the Mapping screen, row by row."|t('kunstmaan-migrator') }}
  </p>
{% endblock %}
