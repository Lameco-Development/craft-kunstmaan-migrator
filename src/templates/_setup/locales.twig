{% extends "kunstmaan-migrator/_setup/_wizard" %}
{% import "_includes/forms.twig" as forms %}

{% block step %}
  {{ actionInput('kunstmaan-migrator/setup/choose-locales') }}
  {{ hiddenInput('envs', envs) }}

  <div class="readable">
    <p>
      {{ "The dropdowns start on the Craft site whose language matches. Check them, and set anything that should not migrate to Not migrating."|t('kunstmaan-migrator') }}
    </p>
  </div>

  {% for label, environment in environments %}
    <div class="pane" style="margin-bottom: 18px;">
      <h2>{{ label }} <span class="light"><code>{{ environment.database }}</code></span></h2>

      <div class="tablepane" style="margin-top: 14px;">
      <table class="data fullwidth">
        <thead>
          <tr>
            <th>{{ "Language"|t('kunstmaan-migrator') }}</th>
            <th class="rightalign">{{ "Pages"|t('kunstmaan-migrator') }}</th>
            <th>{{ "Craft site"|t('kunstmaan-migrator') }}</th>
          </tr>
        </thead>
        <tbody>
          {% for locale, pages in environment.locales %}
            {% set chosen = environment.chosen[locale] ?? {} %}
            <tr>
              <th scope="row"><code>{{ locale }}</code></th>
              <td class="rightalign">{{ pages|number_format }}</td>
              <td>
                {# "Not migrating" carries a real value: selectize cannot select an
                   empty-valued option back once a site has been picked. #}
                {{ forms.selectize({
                  name: 'locales[' ~ label ~ '][' ~ locale ~ '][site]',
                  value: chosen.site|default('') ?: environment.suggested[locale]|default('') ?: '-',
                  options: [{ label: "Not migrating"|t('kunstmaan-migrator'), value: '-' }]|merge(
                    sites|map(s => { label: s.name, value: s.handle })
                  ),
                  class: 'kuma-site',
                }) }}
              </td>
            </tr>
          {% else %}
            <tr><td colspan="3"><p class="zilch small">{{ "This site has no published pages."|t('kunstmaan-migrator') }}</p></td></tr>
          {% endfor %}
        </tbody>
      </table>
      </div>
    </div>
  {% endfor %}

{% endblock %}
