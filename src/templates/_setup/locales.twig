{% extends "kunstmaan-migrator/_setup/_wizard" %}
{% import "_includes/forms.twig" as forms %}

{% block step %}
  {{ actionInput('kunstmaan-migrator/setup/choose-locales') }}
  {{ hiddenInput('envs', envs) }}

  <div class="readable">
    <p>
      {{ "Each language below has real pages in the old site. The dropdowns start on the Craft site whose language matches — check them, change what is off, and set anything that stays behind to Not migrating."|t('kunstmaan-migrator') }}
    </p>
  </div>

  {% for label, environment in environments %}
    <div class="pane" style="margin-bottom: 18px;">
      <h2>{{ label }} <span class="light"><code>{{ environment.database }}</code></span></h2>

      <table class="data fullwidth">
        <thead>
          <tr>
            <th>{{ "Language"|t('kunstmaan-migrator') }}</th>
            <th class="rightalign">{{ "Pages"|t('kunstmaan-migrator') }}</th>
            <th>{{ "Craft site"|t('kunstmaan-migrator') }}</th>
          </tr>
        </thead>
        <tbody>
          {% for locale, pages in environment.locales %}
            {% set chosen = environment.chosen[locale] ?? {} %}
            <tr>
              <th scope="row"><code>{{ locale }}</code></th>
              <td class="rightalign">{{ pages|number_format }}</td>
              <td>
                {{ forms.selectize({
                  name: 'locales[' ~ label ~ '][' ~ locale ~ '][site]',
                  value: chosen.site ?? environment.suggested[locale] ?? '',
                  options: [{ label: "Not migrating"|t('kunstmaan-migrator'), value: '' }]|merge(
                    sites|map(s => { label: s.name, value: s.handle })
                  ),
                  class: 'kuma-site',
                }) }}
              </td>
            </tr>
          {% else %}
            <tr><td colspan="3" class="light">{{ "This site has no published pages."|t('kunstmaan-migrator') }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endfor %}

{% endblock %}
