{% extends "kunstmaan-migrator/_setup/_wizard" %}
{% import "_includes/forms.twig" as forms %}
{% set nextLabel = "Use this site"|t('kunstmaan-migrator') %}

{% block step %}
  {{ actionInput('kunstmaan-migrator/setup/choose-checkout') }}
  <input type="hidden" name="path" id="kuma-checkout-path">

  {% if existingMapping %}
    <blockquote class="note warning">
      <p>
        {{ "A mapping already exists at {path} — the decisions this migration runs on. Finishing the wizard will offer to replace it (the current file is kept as a timestamped copy). To keep working on it instead, head to the Mapping screen."|t('kunstmaan-migrator', { path: '<code>' ~ existingMapping ~ '</code>' })|raw }}
      </p>
    </blockquote>
  {% endif %}

  <div class="readable">
    <p>
      {{ "If the old site's files are on this machine, its own folder already answers the next questions — the database is in its .env, the uploads folder is public/uploads/media. Pick it and everything is prefilled; every value stays editable."|t('kunstmaan-migrator') }}
    </p>
  </div>

  {{ forms.autosuggestField({
    label: "Look in"|t('kunstmaan-migrator'),
    instructions: "The folder your site checkouts live in."|t('kunstmaan-migrator'),
    id: 'kuma-root',
    name: 'root',
    value: root,
    suggestEnvVars: false,
  }) }}
  <p><a class="btn" id="kuma-rescan">{{ "Look again"|t('kunstmaan-migrator') }}</a></p>

  {% if checkouts is empty %}
    <blockquote class="note">
      <p>{{ "No Kunstmaan sites found in {root} — a site is a folder whose composer.lock names a kunstmaan/* package."|t('kunstmaan-migrator', { root: root }) }}</p>
    </blockquote>
  {% else %}
    <table class="data fullwidth" style="margin-top: 10px;">
      <thead>
        <tr>
          <th style="width: 40px;"></th>
          <th>{{ "Site"|t('kunstmaan-migrator') }}</th>
          <th>{{ "Kunstmaan"|t('kunstmaan-migrator') }}</th>
          <th>{{ "Database"|t('kunstmaan-migrator') }}</th>
          <th>{{ "Uploads"|t('kunstmaan-migrator') }}</th>
        </tr>
      </thead>
      <tbody>
        {% for checkout in checkouts %}
          <tr>
            <td>
              <input type="radio" name="pick" class="kuma-pick" id="pick-{{ loop.index }}" value="{{ checkout.path }}">
              <label for="pick-{{ loop.index }}"></label>
            </td>
            <th scope="row"><label for="pick-{{ loop.index }}">{{ checkout.name }}</label><br><span class="light"><code>{{ checkout.path }}</code></span></th>
            <td>{{ checkout.kunstmaan }}</td>
            <td>{% if checkout.database %}<code>{{ checkout.database.database }}</code>{% else %}<span class="light">{{ "not in .env"|t('kunstmaan-migrator') }}</span>{% endif %}</td>
            <td>{% if checkout.mediaRoot %}{{ "found"|t('kunstmaan-migrator') }}{% else %}<span class="light">—</span>{% endif %}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}

  <p style="margin-top: 16px;">
    <a href="{{ url('kunstmaan-migrator/setup/connect') }}">{{ "The old site is not on this machine — enter the connection by hand"|t('kunstmaan-migrator') }}</a>
  </p>

  {% js %}
    var path = document.getElementById('kuma-checkout-path');
    var saves = function () { return [].slice.call(document.querySelectorAll('#main-form button[type=submit]')); };
    saves().forEach(function (b) { b.disabled = true; });

    document.addEventListener('change', function (e) {
      if (!e.target.classList.contains('kuma-pick')) { return; }
      path.value = e.target.value;
      saves().forEach(function (b) { b.disabled = false; });
    });

    document.getElementById('kuma-rescan').addEventListener('click', function () {
      var root = document.getElementById('kuma-root').value;
      window.location = '{{ url('kunstmaan-migrator/setup/detect') }}' + (root ? '?root=' + encodeURIComponent(root) : '');
    });
  {% endjs %}
{% endblock %}
